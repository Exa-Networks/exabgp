#!/usr/bin/env python3
"""ExaBGP JSON regression tests (library-based implementation).

This test suite validates JSON output from BGP message decoding.
Uses library calls directly instead of subprocess forks for faster execution.

CI files can include expected JSON using three tag types:

    option:file:config.conf
    1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:0040:02:...
    1:json:{"exabgp": "6.0.0", ...}    # Tests with both v4 and v6 encoders
    1:jsv4:{"exabgp": "4.0.1", ...}    # Tests with v4 encoder only
    1:jsv6:{"exabgp": "6.0.0", ...}    # Tests with v6 encoder only

The raw: line is read by qa/bin/ci_raw.py, shared with test_api_encode, so the two agree
about what is in the corpus.  Whatever this run does not check, it says so and names it:
see the Skipped breakdown in the summary.

Tag usage:
    - json:  Use when v4 and v6 produce identical output (most cases)
    - jsv4: + jsv6:  Use when v4 and v6 differ (e.g., Flow NLRI nexthop)

Usage:
    ./qa/bin/test_json_lib                 # Run all JSON regression tests
    ./qa/bin/test_json_lib --generate      # Generate missing json: lines
    ./qa/bin/test_json_lib --verbose       # Show detailed output
    ./qa/bin/test_json_lib file.ci         # Test specific CI file

Exit codes:
    0 - All tests passed
    1 - Some tests failed
    2 - No tests found
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# Add src to path for library imports
REPO_ROOT = Path(__file__).parent.parent.parent
sys.path.insert(0, str(REPO_ROOT / 'src'))
# ci_raw sits next to this file: one reader for raw: lines, shared with test_api_encode
sys.path.insert(0, str(Path(__file__).parent))

from ci_raw import RawCapture, RawProblem, Skipped, parse_raw, report_problems, report_skipped, where

# Now import exabgp modules
from exabgp.environment import getenv
from exabgp.configuration.configuration import Configuration

from exabgp.configuration.check import _hexa, _make_update
from exabgp.reactor.api.response import Response
from exabgp.bgp.message.open.capability.negotiated import Negotiated
from exabgp.bgp.neighbor import Neighbor
from exabgp.version import json as json_v6_version
from exabgp.version import json_v4 as json_v4_version


def is_step(text: str) -> bool:
    """Whether this is a step label, by the same rule ci_raw applies to a raw: line.

    The two readers must agree about what a step looks like or an expectation can be
    written, stored and never read, which is what happened with A1/B1/C1.
    """
    return bool(text) and ':' not in text and not text[0].isspace()


# ANSI color codes
GREEN = '\033[32m'
RED = '\033[31m'
YELLOW = '\033[33m'
RESET = '\033[0m'

# Cache for initialized neighbors
_neighbor_cache: dict[Path | None, Neighbor] = {}


def init_environment() -> None:
    """Initialize exabgp environment (once per test run)."""
    env = getenv()
    env.bgp.passive = True
    env.log.enable = False
    env.tcp.bind = []


def get_neighbor(config_file: Path | None) -> Neighbor:
    """Get or create a neighbor for the given config file.

    Args:
        config_file: Path to config file, or None for default neighbor

    Returns:
        Neighbor instance configured for decoding
    """
    if config_file in _neighbor_cache:
        return _neighbor_cache[config_file]

    if config_file and config_file.exists():
        # Load neighbor from config file
        try:
            config = Configuration([str(config_file)])
            config.reload()  # Must call reload() to parse the config
            neighbors = list(config.neighbors.values())
            if neighbors:
                neighbor = neighbors[0]
                _neighbor_cache[config_file] = neighbor
                return neighbor
        except Exception:
            pass  # Fall through to default

    # Create default neighbor with all families
    config_text = """
    neighbor 127.0.0.1 {
        router-id 10.0.0.2;
        local-address 127.0.0.1;
        local-as 65533;
        peer-as 65533;
        family { all }
    }
    """
    try:
        config = Configuration([config_text], text=True)
        config.reload()  # Must call reload() to parse the config
        neighbor = list(config.neighbors.values())[0]
        _neighbor_cache[config_file] = neighbor
        return neighbor
    except Exception as e:
        raise RuntimeError(f'Failed to create default neighbor: {e}')


def decode_message(payload_hex: str, neighbor: Neighbor, api_version: int = 6) -> dict | None:
    """Decode a BGP UPDATE message to JSON using library directly.

    Args:
        payload_hex: The BGP UPDATE payload in hex
        neighbor: Neighbor for negotiation context
        api_version: API version (4 or 6)

    Returns:
        Parsed JSON dict or None on error
    """
    try:
        raw = _hexa(payload_hex)
        update = _make_update(neighbor, raw)
        if not update:
            return None

        # Select encoder based on API version
        if api_version == 4:
            encoder = Response.V4.JSON(json_v4_version)
        else:
            encoder = Response.JSON(json_v6_version)

        json_str = encoder.update(neighbor, 'in', update, b'', b'', Negotiated.UNSET)
        return json.loads(json_str)
    except Exception:
        return None


def normalize_json(data: dict) -> dict:
    """Normalize JSON for comparison by removing volatile fields.

    Removes fields that change between runs:
    - time, host, pid, ppid, counter
    - neighbor addresses (depend on test setup)
    """
    if not isinstance(data, dict):
        return data

    # Fields to remove for comparison
    volatile_fields = {'time', 'host', 'pid', 'ppid', 'counter'}

    normalized = {}
    for key, value in data.items():
        if key in volatile_fields:
            continue
        if isinstance(value, dict):
            normalized[key] = normalize_json(value)
        elif isinstance(value, list):
            normalized[key] = [normalize_json(item) if isinstance(item, dict) else item for item in value]
        else:
            normalized[key] = value

    return normalized


class JsonExpectation:
    """Container for JSON expectations with version-specific support."""

    def __init__(self) -> None:
        self.json: str | None = None  # Universal (both v4 and v6)
        self.jsv4: str | None = None  # v4-specific
        self.jsv6: str | None = None  # v6-specific


END_OF_RIB = 'End-of-RIB, which carries no NLRI to decode'
NO_EXPECTATION = 'no json:/jsv4:/jsv6: expectation to compare against'
DECODE_FAILED = 'the decoder returned nothing'

# The reasons which mean a capture is covered by nothing here, so they get named as well
# as counted.  End-of-RIB and the non-UPDATE message types are skipped on purpose.
MISSING_COVERAGE = {NO_EXPECTATION}


class CiFile:
    """Everything one .ci file offers this test, including what it does not offer."""

    __slots__ = ('config_file', 'messages', 'skipped', 'problems')

    def __init__(self, config_file: Path | None) -> None:
        self.config_file = config_file
        self.messages: list[tuple[RawCapture, JsonExpectation]] = []
        self.skipped: list[Skipped] = []
        self.problems: list[tuple[str, RawProblem]] = []


def parse_ci_file(ci_path: Path, relative: object) -> CiFile:
    """Parse a CI file for raw captures and json expectations.

    Every `raw:` line in the file comes back in exactly one of three places: as a message
    to check, as a Skipped with the reason it is not checked, or as a RawProblem.  Nothing
    falls out of the loop; a line which matched no pattern used to, and 54 captures lived
    in that gap.

    Expected CI file format, with the hexadecimal punctuated however the file likes:
        option:file:config.conf
        N:raw:MARKER:LENGTH:TYPE:PAYLOAD
        N:json:{...}                      # or N:jsv4:{...} and/or N:jsv6:{...}
    """
    parsed = CiFile(None)

    current_raw: RawCapture | None = None
    current_exp = JsonExpectation()

    def close_current() -> None:
        """File the capture we were collecting expectations for, checked or not."""
        if current_raw is None:
            return
        parsed.messages.append((current_raw, current_exp))
        if not (current_exp.json or current_exp.jsv4 or current_exp.jsv6):
            parsed.skipped.append(Skipped(where(relative, current_raw), NO_EXPECTATION))

    with open(ci_path) as handle:
        for line_number, line in enumerate(handle, 1):
            line = line.strip()
            if not line or line.startswith('#'):
                continue

            # Parse option:file:config.conf
            if line.startswith('option:file:'):
                config_name = line.split(':', 2)[2]
                # Config might be in same directory or etc/exabgp/
                config_file = ci_path.parent / config_name
                if not config_file.exists():
                    config_file = ci_path.parent.parent.parent / 'etc' / 'exabgp' / config_name
                parsed.config_file = config_file
                continue

            capture = parse_raw(line, line_number)
            if isinstance(capture, RawProblem):
                parsed.problems.append((f'{relative}:{line_number}', capture))
                continue

            if isinstance(capture, RawCapture):
                close_current()
                current_raw = None
                current_exp = JsonExpectation()

                if not capture.is_update:
                    reason = f'not an UPDATE (message type 0x{capture.message_type})'
                    parsed.skipped.append(Skipped(where(relative, capture), reason))
                    continue
                if capture.is_end_of_rib:
                    parsed.skipped.append(Skipped(where(relative, capture), END_OF_RIB))
                    continue

                current_raw = capture
                continue

            # Parse <step>:json:, <step>:jsv4:, <step>:jsv6:
            #
            # The step is whatever ci_raw._CAPTURE accepts on the raw: line it belongs to,
            # which is any run of non-colon non-space characters.  This used to require
            # isdigit(), so an expectation written against api-reload.ci's A1/B1/C1 labels
            # was read off the file and dropped, while the raw: line beside it parsed
            # fine: the same dialect split ci_raw.py was written to end, one layer up.
            # Ten expectations sat inert in the tree because of it, reported as missing
            # by the very summary that was ignoring them.
            parts = line.split(':', 2)
            if len(parts) == 3 and is_step(parts[0]) and parts[1] in ('json', 'jsv4', 'jsv6'):
                step, tag, json_str = parts

                # Attach to current raw message
                if current_raw is None:
                    # json without preceding raw - skip
                    continue

                if tag == 'json':
                    current_exp.json = json_str
                elif tag == 'jsv4':
                    current_exp.jsv4 = json_str
                elif tag == 'jsv6':
                    current_exp.jsv6 = json_str

    close_current()

    return parsed


def compare_json(decoded: dict, expected_json: str, verbose: bool, step: str, label: str) -> bool:
    """Compare decoded JSON with expected JSON string.

    Returns:
        True if match, False otherwise
    """
    try:
        expected = json.loads(expected_json)
        normalized_decoded = normalize_json(decoded)
        normalized_expected = normalize_json(expected)

        if normalized_decoded == normalized_expected:
            return True
        else:
            print(f'    {RED}FAIL{RESET} step {step} ({label}): JSON mismatch')
            if verbose:
                # Find the first difference
                exp_str = json.dumps(normalized_expected, sort_keys=True)
                got_str = json.dumps(normalized_decoded, sort_keys=True)
                for i, (e, g) in enumerate(zip(exp_str, got_str)):
                    if e != g:
                        print(f'      first diff at char {i}:')
                        print(f'      expected: ...{exp_str[max(0, i - 20) : i + 50]}...')
                        print(f'      got:      ...{got_str[max(0, i - 20) : i + 50]}...')
                        break
                else:
                    # Length difference
                    print(f'      length diff: expected {len(exp_str)}, got {len(got_str)}')
            return False
    except json.JSONDecodeError:
        print(f'    {RED}FAIL{RESET} step {step} ({label}): invalid expected JSON')
        return False


def check_against(
    payload: str,
    neighbor: Neighbor,
    api_version: int,
    expected: str,
    verbose: bool,
    step: str,
    label: str,
    shared: bool,
) -> bool:
    """Decode with one encoder and compare against one expectation.

    `shared` says the expectation is a json: line, held against both encoders, so the
    version field must not be what tells them apart.  A jsv4: line records the v4 encoder
    and keeps its own version.

    A decode which returns nothing is a FAILURE, not a skip.  It used to print a line in
    verbose mode and leave step_passed True, so a capture the decoder had stopped being
    able to read counted as a pass.
    """
    decoded = decode_message(payload, neighbor, api_version=api_version)
    if decoded is None:
        print(f'    {RED}FAIL{RESET} step {step} ({label}): {DECODE_FAILED}')
        return False
    if shared and api_version == 4 and 'exabgp' in decoded:
        decoded['exabgp'] = json_v6_version
    return compare_json(decoded, expected, verbose, step, label)


def check_message(capture: RawCapture, expectations: JsonExpectation, neighbor: Neighbor, verbose: bool) -> bool:
    """Check one capture against every expectation recorded for it."""
    payload = capture.payload
    step = capture.step
    passed = True

    if expectations.json:
        # json: must hold for both encoders
        for api_version in (4, 6):
            label = f'v{api_version}'
            if not check_against(payload, neighbor, api_version, expectations.json, verbose, step, label, True):
                passed = False
    if expectations.jsv4 and not check_against(payload, neighbor, 4, expectations.jsv4, verbose, step, 'jsv4', False):
        passed = False
    if expectations.jsv6 and not check_against(payload, neighbor, 6, expectations.jsv6, verbose, step, 'jsv6', False):
        passed = False

    if passed and verbose:
        print(f'    {GREEN}PASS{RESET} step {step}')
    return passed


def generate_message(capture: RawCapture, neighbor: Neighbor, verbose: bool) -> list[str]:
    """Produce the json:/jsv4:/jsv6: lines for one capture, or nothing if it will not decode."""
    step = capture.step
    payload = capture.payload
    decoded_v4 = decode_message(payload, neighbor, api_version=4)
    decoded_v6 = decode_message(payload, neighbor, api_version=6)

    if decoded_v6 is None:
        print(f'    {RED}SKIP{RESET} step {step}: {DECODE_FAILED}, no expectation written')
        return []

    clean_v6 = normalize_json(decoded_v6)
    if decoded_v4 is None:
        if verbose:
            print(f'    {GREEN}GEN{RESET} step {step} (jsv6 only)')
        return [f'{step}:jsv6:{json.dumps(clean_v6, separators=(",", ":"))}']

    # Compare the two encoders with the version field neutralised, so that only a real
    # difference in the rendering splits the expectation in two.
    comparable_v4 = dict(decoded_v4)
    if 'exabgp' in comparable_v4:
        comparable_v4['exabgp'] = json_v6_version
    if normalize_json(comparable_v4) == clean_v6:
        if verbose:
            print(f'    {GREEN}GEN{RESET} step {step} (json)')
        return [f'{step}:json:{json.dumps(clean_v6, separators=(",", ":"))}']

    if verbose:
        print(f'    {GREEN}GEN{RESET} step {step} (jsv4 + jsv6)')
    clean_v4 = normalize_json(decoded_v4)
    return [
        f'{step}:jsv4:{json.dumps(clean_v4, separators=(",", ":"))}',
        f'{step}:jsv6:{json.dumps(clean_v6, separators=(",", ":"))}',
    ]


def test_ci_file(
    ci_path: Path, relative: object, verbose: bool = False, generate: bool = False
) -> tuple[int, int, list[tuple[str, list[str]]], list[Skipped], list[tuple[str, RawProblem]]]:
    """Test a single CI file.

    Returns:
        (passed, failed, generated entries, skipped captures, unreadable lines)
    """
    parsed = parse_ci_file(ci_path, relative)

    # When generating, a capture with no expectation is the whole point of the run rather
    # than a gap in it, so it is not reported as skipped and not double counted.
    if generate:
        parsed.skipped = [entry for entry in parsed.skipped if entry.reason != NO_EXPECTATION]

    if not parsed.messages:
        return 0, 0, [], parsed.skipped, parsed.problems

    neighbor = get_neighbor(parsed.config_file)

    passed = 0
    failed = 0
    generated_entries: list[tuple[str, list[str]]] = []

    for capture, expectations in parsed.messages:
        if generate:
            json_lines = generate_message(capture, neighbor, verbose)
            if json_lines:
                generated_entries.append((capture.payload, json_lines))
                passed += 1
            continue

        if not (expectations.json or expectations.jsv4 or expectations.jsv6):
            # Already recorded as a skip by the parser, with its file and line number.
            continue

        if check_message(capture, expectations, neighbor, verbose):
            passed += 1
        else:
            failed += 1

    return passed, failed, generated_entries, parsed.skipped, parsed.problems


def insert_json_lines(ci_path: Path, generated_entries: list[tuple[str, list[str]]]) -> bool:
    """Insert json: lines into CI file after corresponding raw: lines.

    Args:
        ci_path: Path to CI file
        generated_entries: List of (payload, json_lines) tuples from successful decodes

    Returns:
        True if file was modified
    """
    # Build a dict from payload -> json lines for that payload
    json_by_payload: dict[str, list[str]] = {}
    for payload, json_lines in generated_entries:
        # Normalize payload to uppercase for matching
        json_by_payload[payload.upper()] = json_lines

    # Read file and insert json after each non-EOR UPDATE raw line
    lines = ci_path.read_text().splitlines()
    new_lines: list[str] = []

    for i, line in enumerate(lines):
        new_lines.append(line)

        # Check if this is a raw UPDATE line (non-EOR)
        capture = parse_raw(line, i + 1)
        if isinstance(capture, RawCapture) and capture.is_update and not capture.is_end_of_rib:
            payload = capture.payload.upper()

            # Check if next line already has json expectation
            next_line = lines[i + 1] if i + 1 < len(lines) else ''
            has_json = ':json:' in next_line or ':jsv4:' in next_line or ':jsv6:' in next_line

            # Insert generated json if not already present and we have one
            if not has_json and payload in json_by_payload:
                for json_line in json_by_payload[payload]:
                    new_lines.append(json_line)

    # Write back
    new_content = '\n'.join(new_lines) + '\n'
    old_content = ci_path.read_text()

    if new_content != old_content:
        ci_path.write_text(new_content)
        return True
    return False


def replace_json_lines(ci_path: Path, generated_entries: list[tuple[str, list[str]]]) -> bool:
    """Replace json:/jsv4:/jsv6: lines in CI file with newly generated ones.

    Preserves all comments and file structure. Removes old json expectations
    and inserts new ones after corresponding raw: lines.

    Args:
        ci_path: Path to CI file
        generated_entries: List of (payload, json_lines) tuples from successful decodes

    Returns:
        True if file was modified
    """
    # Build a dict from payload -> json lines for that payload
    json_by_payload: dict[str, list[str]] = {}
    for payload, json_lines in generated_entries:
        # Normalize payload to uppercase for matching
        json_by_payload[payload.upper()] = json_lines

    # Read file and process
    lines = ci_path.read_text().splitlines()
    new_lines: list[str] = []

    for line in lines:
        stripped = line.strip()

        # Check if this is an old json expectation line - skip it (will be replaced)
        if stripped and not stripped.startswith('#'):
            parts = stripped.split(':', 2)
            if len(parts) >= 3 and is_step(parts[0]) and parts[1] in ('json', 'jsv4', 'jsv6'):
                # Skip old json expectation - it will be replaced
                continue

        # Keep the line (comment, raw, option, or other)
        new_lines.append(line)

        # Check if this is a raw UPDATE line (non-EOR)
        capture = parse_raw(stripped, 0)
        if isinstance(capture, RawCapture) and capture.is_update and not capture.is_end_of_rib:
            # Insert json lines for this specific payload
            payload = capture.payload.upper()
            if payload in json_by_payload:
                for json_line in json_by_payload[payload]:
                    new_lines.append(json_line)

    # Write back
    new_content = '\n'.join(new_lines) + '\n'
    old_content = ci_path.read_text()

    if new_content != old_content:
        ci_path.write_text(new_content)
        return True
    return False


def find_ci_files(repo_root: Path, paths: list[str] | None = None) -> list[Path]:
    """Find CI files to test.

    Args:
        repo_root: Repository root path
        paths: Optional list of specific files/directories to test

    Returns:
        List of CI file paths
    """
    if paths:
        result = []
        for p in paths:
            path = Path(p)
            if not path.is_absolute():
                path = repo_root / p
            if path.is_file():
                result.append(path)
            elif path.is_dir():
                result.extend(sorted(path.glob('*.ci')))
        return result

    # Default: encoding and api directories
    ci_files = []
    for subdir in ['encoding', 'api']:
        ci_dir = repo_root / 'qa' / subdir
        if ci_dir.exists():
            ci_files.extend(sorted(ci_dir.glob('*.ci')))

    return ci_files


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('-v', '--verbose', action='store_true', help='Show detailed output')
    parser.add_argument('-g', '--generate', action='store_true', help='Generate missing json: lines')
    parser.add_argument('-w', '--write', action='store_true', help='Write generated json: lines to CI files')
    parser.add_argument(
        '-i', '--inline', action='store_true', help='Replace existing json: lines inline (use with --generate)'
    )
    parser.add_argument('--json-only', action='store_true', help='Only test files with json: expectations')
    parser.add_argument('files', nargs='*', help='CI files or directories to test')
    args = parser.parse_args()

    # Validate --inline requires --generate
    if args.inline and not args.generate:
        parser.error('--inline requires --generate')

    # Initialize environment once
    init_environment()

    ci_files = find_ci_files(REPO_ROOT, args.files if args.files else None)

    if not ci_files:
        print('No CI files found')
        return 2

    total_passed = 0
    total_failed = 0
    files_tested = 0
    all_generated: dict[Path, list[str]] = {}
    # Every capture this run met and did not check, and every line it could not read.
    # Every .ci file is walked, including the ones holding no expectation at all: a file
    # skipped whole is a hole the same size as a line skipped quietly.
    all_skipped: list[Skipped] = []
    all_problems: list[tuple[str, RawProblem]] = []

    for ci_file in ci_files:
        rel_path = ci_file.relative_to(REPO_ROOT) if ci_file.is_relative_to(REPO_ROOT) else ci_file

        passed, failed, generated, skipped, problems = test_ci_file(
            ci_file, rel_path, args.verbose, args.generate or args.write or args.inline
        )
        all_skipped.extend(skipped)
        all_problems.extend(problems)

        if passed == 0 and failed == 0:
            continue

        print(f'Testing {rel_path}...')
        files_tested += 1
        total_passed += passed
        total_failed += failed

        if generated:
            all_generated[ci_file] = generated
            if args.inline:
                # Replace existing json lines with new ones
                if replace_json_lines(ci_file, generated):
                    print(f'  {GREEN}REPLACED{RESET} {len(generated)} json lines')
            elif args.write:
                if insert_json_lines(ci_file, generated):
                    print(f'  {GREEN}WROTE{RESET} {len(generated)} json lines')

        if failed > 0:
            print(f'  {RED}FAIL{RESET} {failed}/{passed + failed} messages failed')
        elif not args.verbose and not args.write and not args.inline:
            print(f'  {GREEN}PASS{RESET} {passed} messages')

    # Summary.  The skip count sits beside Passed and Failed because a capture nobody
    # looked at is the thing this suite was getting wrong, and a count of 0 checked reads
    # exactly like a count of 248 checked when only the second number is printed.
    examined = total_passed + total_failed
    print()
    print('=' * 60)
    print('JSON TEST SUMMARY')
    print('=' * 60)
    print(f'Files tested: {files_tested}')
    print(f'Capture lines met: {examined + len(all_skipped) + len(all_problems)}')
    print(f'{GREEN}Passed:{RESET}  {total_passed}')
    print(f'{RED}Failed:{RESET}  {total_failed}')
    print(f'{YELLOW}Skipped:{RESET} {len(all_skipped)}')
    report_skipped(all_skipped, MISSING_COVERAGE)
    if all_problems:
        print(f'{RED}Unreadable:{RESET} {len(all_problems)}')
        report_problems(all_problems)

    # Output generated lines (only if not already written inline)
    if args.generate and all_generated and not args.inline:
        print()
        print('=' * 60)
        print('GENERATED JSON LINES')
        print('=' * 60)
        print('Add these lines to CI files after corresponding raw: lines:')
        print()
        for ci_file, entries in all_generated.items():
            rel_path = ci_file.relative_to(REPO_ROOT) if ci_file.is_relative_to(REPO_ROOT) else ci_file
            print(f'# {rel_path}')
            for payload, json_lines in entries:
                for line in json_lines:
                    print(line)
            print()

    # A line which says raw: and cannot be read is a defect in the corpus or in the
    # reader, and there are none today.  Failing on the first one keeps it that way.
    return 0 if total_failed == 0 and not all_problems else 1


if __name__ == '__main__':
    sys.exit(main())
