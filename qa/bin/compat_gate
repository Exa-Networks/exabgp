#!/usr/bin/env python3
"""Fail if this tree refuses something a previous release accepts.

A unit test asserts the new behaviour, so it can never notice that the new behaviour is a
peering somebody loses on upgrade.  This decodes the same corpus in both trees and compares.

It is the check which found, across the work following GHSA-jcrv-p53f-v5w5: a VPLS length
other than exactly 17, a PMSI whose tunnel does not match its type, an empty IGP tag TLV, a
FlowSpec value encoded in four bytes, a two byte AS4 capability, and a BGP-LS prefix NLRI
without its Local Node Descriptors.  Not one was visible to a unit test.

    ./qa/bin/compat_gate                 # against the previous release tag
    ./qa/bin/compat_gate 5.0.10          # against a tag or a commit
    ./qa/bin/compat_gate --write-corpus  # print what the corpus covers

What counts as a regression:

  ACCEPT  -> refused        a peer which works today stops working
  ACCEPT  -> exception      a new crash

What does not:

  exception -> anything     a crash is not a service worth preserving
  unparseable JSON -> anything
                            a line the consumer cannot read is not one either
  anything in ALLOWED       a deliberate change, with its reason

Every entry in ALLOWED is a deployment which stops working on upgrade.  Keep it short and
argue each one.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent

# A label stack of 0x30 bytes never sets the bottom of stack bit, so the decoder read every
# remaining byte as a label, including the prefix, and reported the route as 0.0.0.0/0.  A
# peer could hand us a default route that way.  RFC 3107 3 puts the bit on the last label
# and it is the only thing on the wire which says where the stack ends, so a stack without
# one is malformed and is refused now.  Nothing can be depending on the old answer: a
# deployment sending these was having its prefix replaced with a default route.
#
# Listed one key at a time rather than as 'nlri-mpls', which would match every labelled
# entry in the corpus and blind the gate to a real regression in that family.
_NO_BOTTOM_OF_STACK = 'a labelled NLRI whose stack has no bottom of stack bit; it decoded to 0.0.0.0/0'

# deliberate changes, each with the reason it is worth the cost
ALLOWED: dict[str, str] = {
    'flow': 'a flow which parsed no component matched everything; RFC 8955 4.3 withdraws it',
    'nlri/ipv4/nlri-mpls/24/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/25/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/26/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/27/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/28/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/29/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/30/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/31/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/32/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv4/nlri-mpls/33/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/24/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/25/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/26/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/27/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/28/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/29/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/30/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/31/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/32/30/b': _NO_BOTTOM_OF_STACK,
    'nlri/ipv6/nlri-mpls/33/30/b': _NO_BOTTOM_OF_STACK,
}


def corpus_program() -> str:
    """The probe, run inside each tree with that tree's own source."""
    return """
import hashlib, json, struct, sys
from exabgp.bgp.message import Action
from exabgp.bgp.message.notification import Notify
from exabgp.bgp.message.open.capability import Capability
from exabgp.bgp.message.open.capability.negotiated import Negotiated
from exabgp.bgp.message.update.attribute import Attribute
from exabgp.bgp.message.update.nlri import NLRI
import importlib, pkgutil
import exabgp.bgp.message.update.attribute as package
for _finder, _name, _is in pkgutil.walk_packages(package.__path__, package.__name__ + '.'):
    try:
        importlib.import_module(_name)
    except Exception:
        pass

try:
    from exabgp.bgp.message.update.attribute.bgpls.linkstate import LinkState
    LSIDS = sorted(LinkState.registered_lsids)
except Exception:
    LSIDS = []

out = {}
seen = {}

def record(key, fn, given=b''):
    # the input is recorded with the verdict, so the driver can prove both trees decoded the
    # same bytes. A corpus built inside the probe is built from that tree's own registries,
    # and two trees quietly comparing different inputs is a gate which reports nothing.
    seen[key] = given.hex()
    try:
        value = fn()
    except Notify:
        out[key] = 'REFUSED'
        return
    except Exception as exc:
        out[key] = 'ERROR:' + type(exc).__name__
        return
    if value is None or value is NLRI.INVALID:
        out[key] = 'REFUSED'
        return
    try:
        rendered = value.json()
    except Exception as exc:
        out[key] = 'RENDER-ERROR:' + type(exc).__name__
        return
    try:
        json.loads(rendered if rendered.startswith('{') else '{' + rendered + '}')
    except ValueError:
        out[key] = 'UNPARSEABLE'
        return
    out[key] = 'ACCEPT:' + hashlib.sha1(rendered.encode()).hexdigest()[:10]

# every length of every family, plus a few fill patterns: enough to find a check written
# tighter than what the decoder reads.
#
# BOTH length framings. Most families put a one byte length in front, VPLS puts two, and a
# corpus which emits only one shape reports a clean run over every family using the other:
# the first version of this gate stayed green while the VPLS check it was written to catch
# was put back. That is the same framing hole which hid the SR Policy names from a
# tunnel encapsulation sweep, and it is why the gate has to be shown to go red.
for afi, safi in sorted(set(NLRI.known_families()), key=lambda f: (int(f[0]), int(f[1]))):
    for length in range(0, 34):
        for fill in (b'\\x00', b'\\xff', b'\\x30'):
            body = fill * length
            for shape, prefix in (('b', bytes([length])), ('h', struct.pack('!H', length))):
                record(
                    'nlri/%s/%s/%d/%s/%s' % (afi, safi, length, fill.hex(), shape),
                    lambda a=afi, s=safi, d=prefix + body: NLRI.unpack_nlri(
                        a, s, d, Action.ANNOUNCE, None, None
                    )[0],
                    prefix + body,
                )

for key in sorted(Attribute.registered_attributes, key=str):
    klass = Attribute.registered_attributes[key]
    for length in range(0, 26):
        for fill in (b'\\x00', b'\\xff'):
            record(
                'attr/%d/%d/%d/%s' % (key[0], key[1], length, fill.hex()),
                lambda k=klass, d=fill * length: k.unpack_attribute(d, Negotiated.UNSET),
                fill * length,
            )

for code in sorted(Capability.registered_capability, key=int):
    for length in range(0, 22):
        for fill in (b'\\x00', b'\\xff'):
            record(
                'cap/%d/%d/%s' % (int(code), length, fill.hex()),
                lambda c=code, d=fill * length: Capability.klass(c).unpack_capability(Capability.klass(c)(), d, c),
                fill * length,
            )

# BGP-LS TLVs need a real Type(2) Length(2) header before their decoder sees anything, so
# random bytes never reach one: this is the sub-registry a flat corpus silently skips
attribute = Attribute.klass_by_id(Attribute.CODE.BGP_LS) if LSIDS else None
for code in LSIDS:
    for length in range(0, 26):
        for fill in (b'\\x00', b'\\xff', b'\\x30'):
            record(
                'lsid/%d/%d/%s' % (code, length, fill.hex()),
                lambda a=attribute, c=code, ln=length, f=fill: a.unpack_attribute(
                    struct.pack('!HH', c, ln) + f * ln, Negotiated.UNSET
                ),
                struct.pack('!HH', code, length) + fill * length,
            )

json.dump({'verdict': out, 'input': seen}, open(sys.argv[1], 'w'), sort_keys=True)
sys.stderr.write('%d observations\\n' % len(out))
"""


class CannotObserve(Exception):
    """The other tree could not run the probe, so there is nothing to compare."""


def observe(tree: Path, destination: Path) -> dict[str, str]:
    program = tree / 'compat_corpus.py'
    program.write_text(corpus_program())
    environment = dict(os.environ)
    environment['exabgp_log_enable'] = 'false'
    environment['PYTHONPATH'] = str(tree / 'src')
    result = subprocess.run(
        [
            'uv',
            'run',
            '--no-project',
            '--with',
            'hypothesis',
            '--python',
            '3.12',
            'python',
            str(program),
            str(destination),
        ],
        cwd=tree,
        env=environment,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise CannotObserve(
            f'the probe did not run in {tree}:\n{result.stderr.strip()[-700:]}\n'
            'a tree which cannot execute this probe cannot be compared against it'
        )
    sys.stderr.write(result.stderr)
    program.unlink()
    loaded: dict[str, dict[str, str]] = json.loads(destination.read_text())
    return loaded


def previous_release() -> str:
    """What to compare against when nobody said.

    Not the newest tag. The newest tag reachable from main is from the 4.2 series, whose
    source cannot execute this probe at all, so a release comparison needs a tag someone
    chose deliberately:

        ./qa/bin/compat_gate 5.0.10

    What CI wants is different and more useful continuously: this change must not refuse
    what the branch already accepts. So the default walks back from the most specific thing
    available, the base of a pull request, then the upstream branch, then the previous
    commit.
    """
    for candidate in (
        os.environ.get('GITHUB_BASE_REF') and f'origin/{os.environ["GITHUB_BASE_REF"]}',
        '@{upstream}',
        'HEAD~1',
    ):
        if not candidate:
            continue
        found = subprocess.run(
            ['git', 'rev-parse', '--verify', '--quiet', f'{candidate}^{{commit}}'],
            cwd=ROOT,
            capture_output=True,
            text=True,
        )
        if found.returncode == 0:
            return candidate
    sys.stderr.write('nothing to compare against: no base ref, no upstream, no parent commit\n')
    sys.exit(2)


def main(argv: list[str]) -> int:
    if '--write-corpus' in argv:
        sys.stdout.write(corpus_program())
        return 0

    against = argv[0] if argv else previous_release()
    sys.stderr.write('comparing this tree against %s\n' % against)

    with tempfile.TemporaryDirectory() as scratch:
        old_tree = Path(scratch) / 'old'
        old_tree.mkdir()
        archive = subprocess.run(['git', 'archive', against], cwd=ROOT, capture_output=True, check=True)
        subprocess.run(['tar', '-x', '-C', str(old_tree)], input=archive.stdout, check=True)

        try:
            before_run = observe(old_tree, Path(scratch) / 'before.json')
            after_run = observe(ROOT, Path(scratch) / 'after.json')
        except CannotObserve as exc:
            sys.stderr.write(f'{exc}\n')
            return 2

    before, after = before_run['verdict'], after_run['verdict']
    given_before, given_after = before_run['input'], after_run['input']

    # a corpus built inside the probe is built from that tree's own registries. If the two
    # trees ever hand their decoders different bytes under the same name, every verdict for
    # that name is meaningless, and the gate says nothing while looking like it says a lot.
    shared = set(before) & set(after)
    mismatched = sorted(key for key in shared if given_before.get(key) != given_after.get(key))
    if mismatched:
        sys.stderr.write('the two trees decoded different bytes for %d inputs, starting with:\n' % len(mismatched))
        for key in mismatched[:5]:
            sys.stderr.write('  %-44s %s vs %s\n' % (key, given_before.get(key), given_after.get(key)))
        sys.stderr.write('the comparison is meaningless until that is fixed\n')
        return 2
    if not shared:
        sys.stderr.write('the two trees share no input at all, so nothing was compared\n')
        return 2

    regressions = []
    for key in sorted(before):
        old, new = before[key], after.get(key, 'MISSING')
        if old == new or not old.startswith('ACCEPT'):
            continue
        if new.startswith('ACCEPT'):
            continue
        if any(allowed in key for allowed in ALLOWED):
            continue
        regressions.append((key, old, new))

    for key, old, new in regressions[:40]:
        sys.stderr.write('  %-40s %s -> %s\n' % (key, old[:12], new[:22]))
    if len(regressions) > 40:
        sys.stderr.write('  ... and %d more\n' % (len(regressions) - 40))

    sys.stderr.write('\n%d inputs compared, %d regressions\n' % (len(before), len(regressions)))
    if ALLOWED:
        sys.stderr.write('allowed, each a deployment which stops working on upgrade:\n')
        for name, why in ALLOWED.items():
            sys.stderr.write('  %-12s %s\n' % (name, why))
    return 1 if regressions else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
