#!/usr/bin/env python3
"""Fail when a test file's coverage can shrink without anything going red.

The registries fill by import side effect, and a test which parametrises from one does not
FAIL when the registry is half filled: it runs fewer parameters and passes. 104 green tests
and 41 green tests read identically in a summary line, and a half filled registry is the
failure which actually happens, from import order.

This runs each registry reading test file twice, once normally and once with every registry
thinned to a few entries, and compares the number of tests COLLECTED. Comparing counts
rather than looking for failures is the whole idea, and it came from a pair of files which
behave identically under thinning and mean opposite things:

    a file whose seeds stop decoding fails, and has told you about its seeds
    a file whose count shrinks and whose FLOOR does not fire is the finding

Both halves are needed.  Counting alone flags a file which already has a floor, because
the parametrisation shrinks at collection time whatever the floor does at run time.  And
the second half has to look for the FLOOR failing rather than for any failure: a broken
seed is a red which says nothing about coverage, and accepting it excuses the gap.
Floors carry @pytest.mark.registry_floor so this can ask for them by name.

A file which shrinks needs an assertion that its registry is whole. A file whose count is
unchanged is either seed driven or already floored, and needs nothing.

Two ways this check itself went wrong before it worked, both recorded here rather than
remembered:

  the thinner has to reach the registry the file actually reads. known_families() returns
  registered_families, a different collection from registered_nlri, so thinning the dict
  left a family parametrisation at full width and the file looked immune

  the thinner has to run after the registries are filled. Session 5.0 thinned at
  pytest_configure, before the file under test had imported anything, so it removed nothing
  and reported every file sound. The floor is per registry rather than one number: the
  message registry holds six when complete, fewer than others hold when broken

The second is why FILL_FLOOR exists: a thinner which cannot thin fails loudly instead of
reporting everything clean.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
TESTS = ROOT / 'tests'

KEEP = 3  # what a half filled registry looks like, rather than an empty one
# the thinner must REMOVE something from every registry, or it is reporting on a run it
# did not perturb.  A single count for all of them is wrong: registered_message holds
# six when it is complete, which is fewer than some registries hold when broken.
FILL_FLOOR = KEEP + 1
MAX_REPORTED = 40

TESTS_FAILED = 1  # pytest: some test failed.  5 is no tests collected, which is not the same

THINNER = """
import importlib, pkgutil
import exabgp.bgp.message.update.attribute as package
for _finder, _name, _is_pkg in pkgutil.walk_packages(package.__path__, package.__name__ + '.'):
    try:
        importlib.import_module(_name)
    except Exception:
        pass
import exabgp.reactor.protocol  # noqa: F401  fills the capability and message registries

from exabgp.bgp.message import Message
from exabgp.bgp.message.open.capability import Capability
from exabgp.bgp.message.update.attribute import Attribute
from exabgp.bgp.message.update.attribute.bgpls.linkstate import LinkState
from exabgp.bgp.message.update.nlri import NLRI

KEEP = {keep}
FILL_FLOOR = {floor}

_registries = [
    ('registered_lsids', LinkState.registered_lsids),
    ('registered_attributes', Attribute.registered_attributes),
    ('registered_nlri', NLRI.registered_nlri),
    ('registered_capability', Capability.registered_capability),
    ('registered_message', Message.registered_message),
]

for _label, _registry in _registries:
    if len(_registry) < FILL_FLOOR:
        raise SystemExit(f'thinner cannot thin: {{_label}} holds {{len(_registry)}} before thinning')
    _kept = dict(list(_registry.items())[:KEEP])
    _registry.clear()
    _registry.update(_kept)

# a list rather than a dict, and read by known_families() rather than through
# registered_nlri: a separate collection behind what looks like one dependency
if len(NLRI.registered_families) < FILL_FLOOR:
    raise SystemExit('thinner cannot thin: registered_families is already short')
_families = list(NLRI.registered_families)[:KEEP]
NLRI.registered_families.clear()
NLRI.registered_families.extend(_families)

import pytest

raise SystemExit(pytest.main({args!r}))
"""


def run(args: list[str], thinned: bool) -> subprocess.CompletedProcess[str]:
    """One pytest invocation, with the registries whole or thinned to KEEP entries."""
    if thinned:
        program = THINNER.format(keep=KEEP, floor=FILL_FLOOR, args=args)
        return subprocess.run([sys.executable, '-c', program], capture_output=True, text=True, cwd=ROOT)
    return subprocess.run([sys.executable, '-m', 'pytest', *args], capture_output=True, text=True, cwd=ROOT)


def counts(thinned: bool) -> dict[str, int] | None:
    """How many tests every file offers, from ONE collection of the whole tree.

    This used to pick candidate files by looking for a registry name in their text, then
    collect each one separately: a heuristic, and 352 pytest invocations to check 17 files.
    The heuristic is the part which could be wrong, and being wrong there is silent, since
    a file it does not pick is never measured.  Measured once by hand over every skipped
    file and none shrank, which is exactly the kind of one-off check this whole series has
    been about not relying on.

    Collecting the tree twice costs two invocations and needs no heuristic at all, so there
    is no selection left to get wrong.
    """
    args = [str(TESTS), '-q', '--collect-only', '-p', 'no:randomly', '-p', 'no:cacheprovider']
    result = run(args, thinned)
    if 'thinner cannot thin' in result.stdout + result.stderr:
        print(result.stdout.strip() or result.stderr.strip())
        return None

    per_file: dict[str, int] = {}
    for line in result.stdout.splitlines():
        if '::' not in line:
            continue
        name = line.split('::', 1)[0].strip()
        if name.endswith('.py'):
            per_file[name] = per_file.get(name, 0) + 1
    return per_file


def notices(relative: str) -> bool:
    """Does this file have a floor which FAILS when the registry is thinned?

    Not "does anything fail".  A file whose seeds stop decoding fails too, and it has told
    you about its seeds, so accepting any red excuses a missing floor with collateral
    damage.  Measured: with the floor removed from test_attribute_error_handling, a version
    of this check which accepted any failure reported the whole tree clean, because another
    test in that file broke first.  Session 5.0 had the same bug and it was hiding three
    files on their branch, every one parametrised from a registry with no floor at all.

    So the floors carry a marker and only they are run.  The marker is also what makes this
    cheap: one test per file rather than a Hypothesis sweep per file.
    """
    args = [relative, '-q', '-m', 'registry_floor', '-p', 'no:randomly', '-p', 'no:cacheprovider']
    result = run(args, thinned=True)

    # pytest's exit codes, read as codes.  A file with no floor at all exits 5, NO TESTS
    # COLLECTED, which `returncode != 0` reads as "something failed, so it noticed": the
    # first version of this passed every file whose floor I deleted.  Checking a string
    # instead of the code is what put it there, one message after session 5.0 described
    # reading `tail`'s status instead of their gate's.
    return result.returncode == TESTS_FAILED


def main() -> int:
    whole = counts(thinned=False)
    if whole is None:
        return 1
    thin = counts(thinned=True)
    if thin is None:
        return 1

    if not whole:
        print('collected no tests at all, which cannot be right')
        return 1

    shrinking = []
    for name, before in sorted(whole.items()):
        after = thin.get(name, 0)
        if after < before and not notices(name):
            shrinking.append((name, before, after))

    if not shrinking:
        print(f'{len(whole)} test files, none can shrink silently')
        return 0

    print(f'{len(shrinking)} file(s) run fewer tests on a half filled registry and do not say so:')
    for name, before, after in shrinking[:MAX_REPORTED]:
        print(f'  {name}  {before} -> {after}')
    print()
    print('add a test marked registry_floor asserting the registry it parametrises from is whole.')
    return 1


if __name__ == '__main__':
    sys.exit(main())
