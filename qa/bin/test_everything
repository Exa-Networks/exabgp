#!/usr/bin/env python3
"""
ExaBGP Complete Test Suite Runner

Runs all required tests in sequence, exits on first failure.
Use this instead of running individual test commands.

Usage:
  ./qa/bin/test_everything           # Run all tests with progress
  ./qa/bin/test_everything -l        # List available tests
  ./qa/bin/test_everything --skip-mypy  # Skip mypy type checking
  ./qa/bin/test_everything unit      # Run single test by name
  ./qa/bin/test_everything 3         # Run single test by number
  ./qa/bin/test_everything unit encoding  # Run multiple tests

Exit codes:
  0 - All tests passed
  1 - Test failed
  2 - Invalid arguments
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path


class Colors:
    """ANSI color codes"""

    GREEN = '\033[92m'
    RED = '\033[91m'
    YELLOW = '\033[93m'
    CYAN = '\033[96m'
    BLUE = '\033[94m'
    MAGENTA = '\033[95m'
    WHITE = '\033[97m'
    BOLD = '\033[1m'
    DIM = '\033[2m'
    RESET = '\033[0m'

    @classmethod
    def disable(cls):
        """Disable colors for non-TTY output"""
        cls.GREEN = ''
        cls.RED = ''
        cls.YELLOW = ''
        cls.CYAN = ''
        cls.BLUE = ''
        cls.MAGENTA = ''
        cls.WHITE = ''
        cls.BOLD = ''
        cls.DIM = ''
        cls.RESET = ''


# Disable colors if not in a TTY
if not sys.stdout.isatty():
    Colors.disable()


# Default expected times (seconds) for first run
DEFAULT_TIMES: dict[str, int] = {
    'ruff-format': 3,
    'ruff-check': 3,
    'mypy': 60,
    'unit': 15,
    'optimised': 15,
    'config': 2,
    'no-neighbor': 5,
    'encode-decode': 3,
    'parsing': 6,
    'json': 3,
    'api-encode': 2,
    'cmd-roundtrip': 5,
    'migrate': 2,
    'decoding': 10,
    'encoding': 45,
    'api': 90,
    'cli': 10,
    'type-ignore': 1,
    'tiger-style': 2,
    'tests-run': 6,
    'sweep-floors': 20,
}

CACHE_FILE = Path.home() / '.cache' / 'exabgp' / 'test_times.json'
MAX_HISTORY = 5


def load_timing_cache() -> dict[str, list[float]]:
    """Load timing history from cache file"""
    if CACHE_FILE.exists():
        try:
            with open(CACHE_FILE) as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            pass
    return {}


def save_timing_cache(cache: dict[str, list[float]]) -> None:
    """Save timing history to cache file"""
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    try:
        with open(CACHE_FILE, 'w') as f:
            json.dump(cache, f, indent=2)
    except OSError:
        pass  # Non-critical, ignore write failures


def get_expected_time(cache: dict[str, list[float]], test_name: str) -> float:
    """Get expected time from cache or default"""
    if test_name in cache and cache[test_name]:
        return sum(cache[test_name]) / len(cache[test_name])
    return float(DEFAULT_TIMES.get(test_name, 10))


def record_time(cache: dict[str, list[float]], test_name: str, elapsed: float) -> None:
    """Record actual time to cache (keep last N)"""
    if test_name not in cache:
        cache[test_name] = []
    cache[test_name].append(elapsed)
    cache[test_name] = cache[test_name][-MAX_HISTORY:]


def format_time(seconds: float) -> str:
    """Format seconds as human-readable string"""
    if seconds < 60:
        return f'{seconds:.1f}s'
    minutes = int(seconds // 60)
    secs = seconds % 60
    return f'{minutes}m{secs:.0f}s'


def run_command(cmd: str, env: dict | None = None, shell: bool = True) -> tuple[int, str, str]:
    """Run a command and return exit code, stdout, stderr"""
    full_env = os.environ.copy()
    if env:
        full_env.update(env)

    process = subprocess.Popen(
        cmd, shell=shell, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=full_env, text=True
    )
    stdout, stderr = process.communicate()
    return process.returncode, stdout, stderr


# Test definitions: (name, command, description)
# Commands can be a string or list of strings (run sequentially)
TEST_COMMANDS: dict[str, str | list[str]] = {
    'ruff-format': 'uv run ruff format src tests',
    'ruff-check': 'uv run ruff check src qa tests',
    'mypy': 'uv run mypy src/exabgp/',
    'unit': 'env exabgp_log_enable=false uv run pytest ./tests/ -q',
    # the same suite with assertions removed. An assert which is doing real work passes
    # every normal run and vanishes in production: the BGP-LS decoder boundary was one
    # statement of that shape, and this is the only thing which catches it.
    'optimised': 'env exabgp_log_enable=false PYTHONOPTIMIZE=1 uv run pytest ./tests/ -q',
    'config': './sbin/exabgp configuration validate -nrv ./etc/exabgp/conf-ipself6.conf',
    'no-neighbor': './qa/scripts/test_no_neighbor.py',
    'encode-decode': './qa/scripts/test_encode_decode.py',
    'parsing': './qa/bin/test_parsing',
    'json': './qa/bin/test_json',
    'api-encode': './qa/bin/test_api_encode',
    'cmd-roundtrip': './qa/bin/test_api_encode --self-check',
    'migrate': './qa/bin/test_migrate',
    'decoding': './qa/bin/functional decoding',
    'encoding': ['killall -9 python 2>/dev/null; sleep 0.5', './qa/bin/functional encoding --quiet'],
    'api': './qa/bin/functional api --quiet',
    'cli': './qa/bin/functional cli --quiet',
    'type-ignore': './qa/bin/check_type_ignores',
    'tiger-style': './qa/bin/check_tiger_style',
    'tests-run': './qa/bin/check_tests_run',
    'sweep-floors': './qa/bin/check_sweep_floors',
    'renders-json': './qa/bin/compat_gate --this-tree-only',
    'documentation': './qa/bin/check_documentation',
}

TEST_DESCRIPTIONS: dict[str, str] = {
    'ruff-format': 'Ruff format check',
    'ruff-check': 'Ruff lint check',
    'mypy': 'Mypy strict type check',
    'unit': 'Unit tests (pytest)',
    'optimised': 'Unit tests with assertions removed (-O)',
    'config': 'Configuration validation',
    'no-neighbor': 'No-neighbor API test',
    'encode-decode': 'Encode/decode CLI test',
    'parsing': 'Config file validation',
    'json': 'JSON decode regression tests',
    'api-encode': 'API command encode tests',
    'cmd-roundtrip': 'API cmd round-trip (raw→cmd→raw)',
    'migrate': 'Config/API migration tests',
    'decoding': 'Functional decoding tests',
    'encoding': 'Functional encoding tests',
    'api': 'Functional API tests',
    'cli': 'Functional CLI tests',
    'type-ignore': 'Prohibited # type: comments check',
    'tiger-style': 'Tiger style check',
    'tests-run': 'Every test file is collected',
    'sweep-floors': 'No sweep shrinks silently',
    'renders-json': 'Every corpus input renders JSON a consumer can parse',
    'documentation': 'Documentation matches the code',
}

# Ordered list of test names
TEST_ORDER = [
    'ruff-format',
    'ruff-check',
    'mypy',
    'unit',
    'optimised',
    'config',
    'no-neighbor',
    'encode-decode',
    'parsing',
    'json',
    'api-encode',
    'cmd-roundtrip',
    'migrate',
    'decoding',
    'encoding',
    'cli',
    'api',
    'type-ignore',
    'tiger-style',
    'tests-run',
    'sweep-floors',
    'renders-json',
    'documentation',
]

# A stage in TEST_COMMANDS and not in TEST_ORDER never runs, and the suite still prints
# "All N tests passed" because N counts what ran.  That is how renders-json was added,
# reported green, and had not executed once.  A gate which does not run is worse than a
# missing gate: the missing one does not tell you it is fine.
# Every directory under tests/ which defines tests has to be REACHED by a pytest stage.
#
# check_tests_run asks whether pytest COLLECTS a file, which is a different question from
# whether anything RUNS it, and the difference had a cost twice over.
#
# tests/async_debug held two tests broken against the packed-bytes-first refactor, calling
# INET(action=...) and rib._refresh_changes, both long gone.  No stage named the directory
# and check_tests_run was green, because collection is not execution.
#
# Worse in CI, which ran ./tests/unit/test_*.py ./tests/fuzz/test_*.py.  That glob does not
# recurse, so 34 files in subdirectories of tests/unit never ran there either: 4341 tests of
# the 5193 in the tree, green about 84% of itself.  Session 5.0 found the same enumeration
# on their branch and made the argument this now follows: adding the missing paths to a hand
# written list reloads the same gun, so name the root instead.
#
# Hence the check below is not "is this directory listed" but "does a stage reach it".  A
# stage naming ./tests reaches all of them and a list of children reaches only what it names.
NOT_A_SUITE: dict[str, str] = {
    # empty on purpose.  tests/performance looked like a timing suite and is not: all 52 of
    # its assertions are counts and equalities, the wall clock it samples is reported and
    # never asserted against, and baseline.json is referenced by no test.  Grepping for
    # 'time' said otherwise, which is how it nearly ended up excused here.
}

_test_root = Path(__file__).resolve().parent.parent.parent / 'tests'
if _test_root.is_dir():
    _stage_text = ' '.join(
        part for command in TEST_COMMANDS.values() for part in ([command] if isinstance(command, str) else command)
    )
    _whole_tree = './tests/ ' in _stage_text or './tests ' in _stage_text
    _with_tests = {entry.name for entry in _test_root.iterdir() if entry.is_dir() and any(entry.rglob('test_*.py'))}
    _unrun = sorted(
        name
        for name in _with_tests
        if not _whole_tree and f'tests/{name}' not in _stage_text and name not in NOT_A_SUITE
    )
    _gone = sorted(NOT_A_SUITE.keys() - _with_tests)
    if _unrun or _gone:
        raise SystemExit(
            'tests/ is inconsistent: %s defines tests which no stage reaches, %s named as not-a-suite but holds no tests'
            % (_unrun or 'none', _gone or 'none')
        )


# A pytest invocation must name the ROOT of tests/, never its children.  This applies to
# the stages above and to the workflows alike, because the two have to agree about what
# "the tests" means or only one of them is right.
#
# Checking the FORM rather than the coverage, which is the correction.  The per-directory
# check below asks whether each directory is named somewhere, and
#
#     pytest ./tests/unit/test_*.py ./tests/fuzz/test_*.py ./tests/integration ./tests/performance
#
# satisfies every part of it: each directory appears, so nothing is reported unrun, and the
# glob still skips every subdirectory of tests/unit.  That is the patch a careful person
# writes after being told which directories were missing, and the coverage check blesses it.
# Session 5.0 found their version of this gate had exactly that weakness, which is what
# prompted looking here; mine had it too, and let the form above through in silence.
#
# So the rule is the shape, not the list: no child of tests/ on a pytest command line.
# Deliberately scoped runs, which are a different thing from a pipeline naming a subset.
# check_perf exists to run the performance suite and mutation_test scopes mutmut's runner
# so a mutation round finishes this century.  Both name one suite on purpose; neither
# claims to be "the tests".
SCOPED_ON_PURPOSE = {
    'check_perf': 'runs tests/performance, which is its entire job',
    'mutation_test': 'scopes the mutmut runner, which re-runs the suite once per mutant',
}


def workflow_files(root: Path) -> list[Path]:
    """Every CI workflow in the tree, whatever forge and whichever spelling.

    Takes a root so the control below runs THIS function rather than a second glob beside
    it.  The first version of that control had its own copy of the pattern, so narrowing
    this walk back to .github left the control green: it was asserting about a glob nothing
    used.  Caught by running the mutation instead of reading the two lines and seeing that
    they matched.
    """
    return sorted(set(root.glob('.*/workflows/*.yml')) | set(root.glob('.*/workflows/*.yaml')))


def _pytest_lines() -> list[tuple[str, str]]:
    """Every pytest invocation in the pipeline: the stages, the workflows, the shell tools.

    Reading shell sources as well as workflows because the gap between them is where things
    live.  Session 5.0 found qa/bin/cover there: it named a child of tests/ AND globbed
    *_test.py, which matches nothing in a tree whose files are test_*.py, so it had been
    reporting coverage over zero tests for as long as it existed.  It cleared their form
    check by not being a workflow and their directory walk by being correctly excluded as a
    tool.  Two exclusions, each right alone, and a file nothing looked at in the middle.

    Python tools in qa/bin are excluded on purpose, and the boundary is load-bearing rather
    than incidental: check_sweep_floors and check_tests_run drive pytest per file as their
    method, so scanning them flags the tool instead of the pipeline.
    """
    root = Path(__file__).resolve().parent.parent.parent
    lines = []
    for command in TEST_COMMANDS.values():
        for part in [command] if isinstance(command, str) else command:
            if 'pytest' in part:
                lines.append(('a stage in this file', part))
    # EVERY workflow directory and BOTH spellings.  Two assumptions were wearing one
    # hardcoded path here.
    #
    # This read .github/workflows only, and .forgejo/workflows/unit-testing.yml sat outside
    # it running the old glob, so the codeberg CI, which is the remote this repository
    # actually pushes to, went on running 4341 of 5193 tests after the github one was fixed.
    #
    # Widening that left the second assumption in place: the glob was *.yml, so a workflow
    # named unit-testing.yaml stayed invisible.  Measured by planting one, and the gate
    # exited 0 without a word.  Session 5.0 found this half on their branch, where the forge
    # half was not live, which is why it is worth widening both rather than the one your own
    # tree happens to punish you for.
    for flow in workflow_files(root):
        for number, line in enumerate(flow.read_text().splitlines(), 1):
            if 'pytest' in line and not line.lstrip().startswith('#'):
                lines.append((f'{flow.parent.parent.name}/{flow.name}:{number}', line))
    for tool in sorted((root / 'qa' / 'bin').iterdir()):
        if not tool.is_file() or not os.access(tool, os.X_OK) or tool.name in SCOPED_ON_PURPOSE:
            continue
        try:
            text = tool.read_text()
        except (OSError, UnicodeDecodeError):
            continue
        if text.startswith('#!') and 'python' in text.splitlines()[0]:
            continue
        for number, line in enumerate(text.splitlines(), 1):
            if 'pytest' in line and not line.lstrip().startswith('#'):
                lines.append((f'qa/bin/{tool.name}:{number}', line))
    return lines


def _narrow_pytest_paths() -> list[str]:
    return [
        f'{where}: {line.strip()[:70]}'
        for where, line in _pytest_lines()
        if 'tests/unit' in line or 'tests/fuzz' in line or 'test_*.py' in line
    ]


def _paths_selecting_nothing() -> list[str]:
    """A pytest path which matches no file is worse than one which matches too few.

    5.0's, and the reason is that every number downstream stays real and consistent and is
    about nothing at all.  Being a child of tests/ and matching nothing are separate
    defects; only the first is about recursion.
    """
    root = Path(__file__).resolve().parent.parent.parent
    empty = []
    for where, line in _pytest_lines():
        for token in line.replace("'", ' ').replace('"', ' ').split():
            if not token.startswith(('./tests', 'tests/')):
                continue
            cleaned = token.rstrip('\\').rstrip('/')
            if any(char in cleaned for char in '*?['):
                if not list(root.glob(cleaned.lstrip('./'))):
                    empty.append(f'{where}: {token} matches no file')
            elif not (root / cleaned.lstrip('./')).exists():
                empty.append(f'{where}: {token} does not exist')
    return empty


# Controls for the walk itself.  A walk which resolves the directories the hardcoded path
# used to resolve agrees with what it replaced and says nothing about the cases it was
# widened for, so those are asserted by name, through the same function the reader uses.
_WORKFLOW_DIRECTORIES = {'.github', '.forgejo'}
_root = Path(__file__).resolve().parent.parent.parent
_seen_forges = {flow.parent.parent.name for flow in workflow_files(_root)}
if not _WORKFLOW_DIRECTORIES <= _seen_forges:
    raise SystemExit(
        'the workflow walk no longer reaches %s, so the form check below is not reading the '
        'CI it claims to read' % ', '.join(sorted(_WORKFLOW_DIRECTORIES - _seen_forges))
    )

# The positive control for the spelling lives in tests/unit/test_gates_are_wired.py.
#
# It plants a tree holding a.yml and b.yaml and points workflow_files at it, which is
# filesystem work, and this module must stay importable without doing any: that test
# imports this file to run these guards where CI can see them, and creating temporary
# directories as a side effect of import broke six tests in the full suite.  A control
# belongs in a test; a guard belongs here.

_narrow = _narrow_pytest_paths()
if _narrow:
    raise SystemExit(
        'pytest is run over children of tests/ rather than the root, which skips whatever is '
        'added next: %s' % ', '.join(_narrow)
    )

# A pytest invocation with NO path argument means whatever the layout means, unless
# testpaths says otherwise.  The form check above reads path arguments and has nothing to
# say about a bare one, which is 5.0's finding: theirs agreed with ./tests only because
# nothing outside tests/ happened to be named test_*.py, a fact about a directory listing
# rather than a setting.  Here they did not even agree: bare pytest walked mutants/, the
# gitignored 33M mutmut working copy, and collected 5198 with 8 errors against 5193.
if 'testpaths' not in (Path(__file__).resolve().parent.parent.parent / 'pyproject.toml').read_text():
    raise SystemExit(
        'pyproject.toml sets no testpaths, so a bare pytest collects whatever the tree '
        'happens to contain rather than the suite'
    )

_empty = _paths_selecting_nothing()
if _empty:
    raise SystemExit(
        'a pytest path selects nothing, so everything measured through it is about nothing: %s' % ', '.join(_empty)
    )

# The form check above can only fail while there is a subtree for a non-recursive glob to
# miss.  If tests/unit ever flattens, it passes forever and rots into decoration, so this
# says out loud that the two collections differ, and names the file whose absence was the
# reason: 22 tests on the JSON API response encoder, which is the subject of the advisory
# this whole series comes from, and which CI had never run.
_NAMED_SUBTREE_TEST = Path('tests/unit/reactor/api/response/test_json_update.py')
if _test_root.is_dir():
    _flat = {path.name for path in _test_root.glob('*/test_*.py')}
    _deep = {path.name for path in _test_root.rglob('test_*.py')}
    if len(_deep) <= len(_flat):
        raise SystemExit(
            'tests/ has no subdirectory holding tests, so the check above cannot fail and is '
            'no longer evidence of anything: delete it or give it something to catch'
        )
    if not (Path(__file__).resolve().parent.parent.parent / _NAMED_SUBTREE_TEST).is_file():
        raise SystemExit(
            f'{_NAMED_SUBTREE_TEST} has moved.  It is named here because a non-recursive glob '
            'skipped it and CI ran none of its tests; point this at wherever it went, or at '
            'another test living below tests/<directory>/'
        )

# Everything in qa/bin is a gate unless it is named here as a tool, with the reason.
#
# The guard below catches a stage added to one list and not the other, which is how
# renders-json came to exist and never run.  It does NOT catch a gate written and added to
# no list at all: that one is invisible to a check which only compares the lists against
# each other.  Session 5.0 hit the same hole from the other side, with no runner to fall
# between, and their answer generalises past mine: nothing SAID a gate had to be wired.
#
# So the directory is the source of truth and the exclusions are explicit.  The reason
# matters more than the name; an entry nobody can justify is a gate somebody demoted.
NOT_A_GATE = {
    'check_coverage': 'reports coverage, does not fail on it',
    'check_perf': 'measures, and a timing number is not a pass or a fail',
    'cover': 'wrapper around check_coverage',
    'fuzz_hunt': 'the deep random profile, deliberately not a gate: tests/fuzz/conftest.py',
    'mutation_test': 'runs mutmut, which takes hours',
    'mutmut_run': 'runs mutmut, which takes hours',
    'rmpyc': 'deletes .pyc files',
    'sync_requirements.sh': 'regenerates qa/requirements.txt',
    'test_everything': 'this file',
}

_qa_bin = Path(__file__).resolve().parent
_executables = {entry.name for entry in _qa_bin.iterdir() if entry.is_file() and os.access(entry, os.X_OK)}
# matched as a whole path, not as a substring: 'cover' occurs inside 'check_coverage',
# so a loose match would call the wrapper wired because something else runs the checker
_invocations = ' '.join(
    part for command in TEST_COMMANDS.values() for part in ([command] if isinstance(command, str) else command)
)
_wired = {name for name in _executables if f'qa/bin/{name}' in _invocations}

# the exclusion list is where this comes back, so it is checked too: a tool which was
# renamed or deleted leaves an entry here which silently excuses nothing, and the next
# gate to take that name inherits the excuse
_stale = sorted(NOT_A_GATE.keys() - _executables)
_unwired = sorted(_executables - _wired - NOT_A_GATE.keys())
if _stale or _unwired:
    raise SystemExit(
        'qa/bin is inconsistent: %s runs nothing and is not listed as a tool, %s listed as a tool but does not exist'
        % (_unwired or 'none', _stale or 'none')
    )

_unordered = sorted(set(TEST_COMMANDS) - set(TEST_ORDER))
_unknown = sorted(set(TEST_ORDER) - set(TEST_COMMANDS))
if _unordered or _unknown:
    raise SystemExit(
        'test_everything is inconsistent: %s defined but never run, %s ordered but undefined'
        % (_unordered or 'none', _unknown or 'none')
    )


def run_test(name: str, verbose: bool = False) -> tuple[bool, str, str]:
    """Run a test by name, return (success, stdout, stderr)"""
    cmd = TEST_COMMANDS[name]

    if isinstance(cmd, list):
        # Multiple commands - run sequentially
        all_stdout = []
        all_stderr = []
        for c in cmd:
            if verbose:
                print(f'{Colors.DIM}  $ {c}{Colors.RESET}')
            returncode, stdout, stderr = run_command(c)
            all_stdout.append(stdout)
            all_stderr.append(stderr)
            # Don't fail on setup commands (like killall)
            if returncode != 0 and c == cmd[-1]:
                return False, '\n'.join(all_stdout), '\n'.join(all_stderr)
        stdout = '\n'.join(all_stdout)
        stderr = '\n'.join(all_stderr)
        returncode = 0
    else:
        if verbose:
            print(f'{Colors.DIM}  $ {cmd}{Colors.RESET}')
        returncode, stdout, stderr = run_command(cmd)

    # Special case: functional tests need 100% pass rate check
    if name in ('encoding', 'api', 'cli') and returncode == 0:
        pass_rate_match = re.search(r'100(?:\.\d+)?%', stdout)
        if not pass_rate_match:
            return False, stdout, stderr

    return returncode == 0, stdout, stderr


def list_tests(cache: dict[str, list[float]], verbose: bool = False) -> None:
    """Print available tests with expected times"""
    print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')
    print(f'{Colors.BOLD}{Colors.WHITE}  Available Tests{Colors.RESET}')
    print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')
    for i, name in enumerate(TEST_ORDER, 1):
        expected = get_expected_time(cache, name)
        desc = TEST_DESCRIPTIONS[name]
        num = f'{Colors.CYAN}{i}.{Colors.RESET}'
        test_name = f'{Colors.WHITE}{Colors.BOLD}{name:14}{Colors.RESET}'
        time_str = f'{Colors.BLUE}(~{format_time(expected):>5}){Colors.RESET}'
        desc_str = f'{Colors.DIM}{desc}{Colors.RESET}'
        print(f'  {num} {test_name} {time_str}  {desc_str}')
        if verbose:
            cmd = TEST_COMMANDS[name]
            if isinstance(cmd, list):
                for c in cmd:
                    print(f'{Colors.DIM}      $ {c}{Colors.RESET}')
            else:
                print(f'{Colors.DIM}      $ {cmd}{Colors.RESET}')
    print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')


def resolve_test_selector(selector: str) -> int | None:
    """Resolve a test selector (name or number) to index, or None if invalid"""
    # Try as number first
    try:
        num = int(selector)
        if 1 <= num <= len(TEST_ORDER):
            return num - 1
    except ValueError:
        pass

    # Try as name
    for i, name in enumerate(TEST_ORDER):
        if name == selector:
            return i

    return None


def run_tests(test_indices: list[int], cache: dict[str, list[float]], verbose: bool = False) -> int:
    """Run selected tests with progress output. Returns exit code."""
    start_time = time.time()
    total = len(test_indices)
    results: list[tuple[str, bool, float, float]] = []  # (name, success, elapsed, expected)
    cumulative_time = 0.0  # Track time spent on previous tests

    for run_num, test_idx in enumerate(test_indices, 1):
        name = TEST_ORDER[test_idx]
        desc = TEST_DESCRIPTIONS[name]
        expected = get_expected_time(cache, name)

        # Calculate expected total time at end of this test
        expected_finish = cumulative_time + expected

        # Print progress line with colors
        progress = f'{Colors.CYAN}[{run_num}/{total}]{Colors.RESET}'
        test_name = f'{Colors.WHITE}{Colors.BOLD}{name:14}{Colors.RESET}'
        eta_str = f'{Colors.DIM}({Colors.MAGENTA}ETA {format_time(expected_finish)}{Colors.DIM}){Colors.RESET}'

        if verbose:
            print(f'{progress} {test_name} {eta_str}')
        else:
            print(f'{progress} {test_name} {eta_str} ... ', end='', flush=True)

        test_start = time.time()
        success, stdout, stderr = run_test(name, verbose=verbose)
        elapsed = time.time() - test_start

        # Update cumulative time with actual elapsed
        cumulative_time += elapsed

        # Record timing and result
        record_time(cache, name, elapsed)
        results.append((name, success, elapsed, expected))

        # Show result with colored time (actual vs expected)
        elapsed_str = f'{Colors.BLUE}{format_time(elapsed)}{Colors.RESET}'
        expected_str = f'{Colors.DIM}(~{format_time(expected)}){Colors.RESET}'
        if success:
            print(f'{Colors.GREEN}✓{Colors.RESET} {elapsed_str} {expected_str}')
        else:
            print(f'{Colors.RED}✗{Colors.RESET} {elapsed_str} {expected_str}')

        if not success:
            # Show failure details
            print(f'\n{Colors.RED}{Colors.BOLD}FAILED: {desc}{Colors.RESET}')
            if stdout:
                print(stdout)
            if stderr:
                print(stderr)
            save_timing_cache(cache)
            return 1

    # All passed - show summary
    total_elapsed = time.time() - start_time
    save_timing_cache(cache)

    # Print summary table (verbose only)
    if verbose:
        total_expected = sum(exp for _, _, _, exp in results)
        print()
        print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')
        print(f'{Colors.BOLD}{Colors.WHITE}  Test Summary{Colors.RESET}')
        print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')
        for name, success, elapsed, expected in results:
            status = f'{Colors.GREEN}✓{Colors.RESET}' if success else f'{Colors.RED}✗{Colors.RESET}'
            time_str = f'{Colors.BLUE}{format_time(elapsed):>6}{Colors.RESET}'
            exp_str = f'{Colors.DIM}(~{format_time(expected):>5}){Colors.RESET}'
            print(f'  {status} {name:14} {time_str} {exp_str}')
        print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')
        print(
            f'  {Colors.GREEN}{Colors.BOLD}Total: {format_time(total_elapsed)}{Colors.RESET} {Colors.DIM}(~{format_time(total_expected)}){Colors.RESET}'
        )
        print(f'{Colors.CYAN}{"─" * 60}{Colors.RESET}')
        print()

    print(f'{Colors.GREEN}{Colors.BOLD}✓ All {total} tests passed in {format_time(total_elapsed)}{Colors.RESET}')
    return 0


def main() -> int:
    """Main entry point"""
    parser = argparse.ArgumentParser(
        description='ExaBGP test suite runner',
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('-l', '--list', action='store_true', help='List available tests')
    parser.add_argument('-v', '--verbose', action='store_true', help='Show commands being run')
    parser.add_argument('--skip-mypy', action='store_true', help='Skip mypy type checking')
    parser.add_argument('tests', nargs='*', help='Tests to run (name or number)')

    args = parser.parse_args()
    cache = load_timing_cache()

    if args.list:
        list_tests(cache, verbose=args.verbose)
        return 0

    # Determine which tests to run
    if args.tests:
        test_indices = []
        for selector in args.tests:
            idx = resolve_test_selector(selector)
            if idx is None:
                print(f'{Colors.RED}Unknown test: {selector}{Colors.RESET}')
                print('Use -l to list available tests')
                return 2
            test_indices.append(idx)
    else:
        # Run all tests
        test_indices = list(range(len(TEST_ORDER)))

    # Apply --skip-mypy filter
    if args.skip_mypy:
        mypy_idx = TEST_ORDER.index('mypy') if 'mypy' in TEST_ORDER else None
        if mypy_idx is not None:
            test_indices = [i for i in test_indices if i != mypy_idx]

    return run_tests(test_indices, cache, verbose=args.verbose)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print(f'\n{Colors.YELLOW}Interrupted{Colors.RESET}')
        sys.exit(130)
    except Exception as e:
        print(f'\n{Colors.RED}Error: {e}{Colors.RESET}')
        sys.exit(255)
