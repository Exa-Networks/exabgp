#!/usr/bin/env python3
"""update_wiki_syntax

Write the wiki's Configuration/Syntax-Reference.md from the grammar which reads the
configuration: every section and keyword, what each takes, its default, and what it is for.

The page is generated whole, so it is never edited by hand: change the grammar's `doc` of
a keyword and run this again. The hand-written pages (Configuration-Syntax,
Directives-Reference) link to it.

Usage:
    qa/bin/update_wiki_syntax ../wiki            # write the page
    qa/bin/update_wiki_syntax ../wiki --check    # exit 1 when the page is out of date

Copyright (c) 2009-2026 Exa Networks. All rights reserved.
License: 3-clause BSD. (See the COPYRIGHT file)
"""

from __future__ import annotations

import argparse
import os
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
sys.path.insert(0, os.path.join(ROOT, 'src'))
os.environ.setdefault('exabgp_log_enable', 'false')

from exabgp.configuration.grammar.describe import MANUAL_INDENT, syntax  # noqa: E402
from exabgp.configuration.grammar.render import INDENT  # noqa: E402
from exabgp.configuration.grammar.tree.root import ROOT as GRAMMAR  # noqa: E402

PAGE = os.path.join('Configuration', 'Syntax-Reference.md')

HEAD = """# Configuration Syntax Reference

<!-- generated by qa/bin/update_wiki_syntax in the exabgp repository: do not edit -->

**Every keyword ExaBGP 6.x reads, section by section, printed from the grammar which reads it**

This page is what `exabgp configuration syntax` prints, so it cannot say a keyword exists
which the parser refuses, or miss one it reads. After `#` is what the keyword is for, its
default and whether it is mandatory. `a|b` is one of them, `[...]` is optional, `<...>` is a
value you give. The `;` ending each statement may be left out at the end of a line (6.0): the
line end ends the statement, and a `;` still separates two statements written on one line. For
examples and explanations see [Configuration Syntax](Configuration-Syntax) and
[Directives A-Z](Directives-Reference).

The same grammar prints one section, the help of one statement, and a machine-readable model
of the configuration:

```bash
exabgp configuration syntax neighbor family       # one section
exabgp configuration syntax neighbor hold-time    # one statement: its syntax, default, examples
exabgp configuration syntax --json                # JSON Schema (2020-12)
exabgp configuration syntax --yang                # YANG 1.1 module
```
"""


def sections() -> list[tuple[str, list[str]]]:
    """Each top-level section of the grammar, with its lines."""
    found: list[tuple[str, list[str]]] = []
    for line in syntax(GRAMMAR):
        if not line.startswith(INDENT) and line != '}':
            found.append((line.split(' ', 1)[0], []))
        found[-1][1].append(line.replace(INDENT, MANUAL_INDENT))
    return found


def page() -> str:
    lines = [HEAD.rstrip('\n')]
    for keyword, body in sections():
        lines += ['', f'## {keyword}', '', '```text', *body, '```']
    return '\n'.join(lines) + '\n'


def main() -> int:
    parser = argparse.ArgumentParser(description='write the wiki syntax reference from the grammar')
    parser.add_argument('wiki', help='the wiki repository')
    parser.add_argument('--check', action='store_true', help='exit 1 when the page is out of date')
    arguments = parser.parse_args()
    path = os.path.join(arguments.wiki, PAGE)
    text = page()
    current = open(path, encoding='utf-8').read() if os.path.exists(path) else ''
    if current == text:
        return 0
    if arguments.check:
        sys.stderr.write(f'{path} is out of date, run qa/bin/update_wiki_syntax {arguments.wiki}\n')
        return 1
    with open(path, 'w', encoding='utf-8') as out:
        out.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
