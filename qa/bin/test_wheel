#!/usr/bin/env python3
"""
Test the exabgp installed in the running Python: the wheels workflow runs this against each
compiled wheel it builds (plan/wip-mypyc.md phase 8, doc/user/compiled-build.md).

It checks the message code was loaded compiled, then runs the functional suites against
the installed package: EXABGP_TREE makes sbin/exabgp run it, INTERPRETER with this Python.

Usage:
    python qa/bin/test_wheel             # from the root of the checkout, with psutil installed
    python qa/bin/test_wheel --pure      # the installed package is the pure Python one
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import time
import sys
from pathlib import Path

ROOT = Path(__file__).parent.parent.parent
SUITES = ('decoding', 'encoding', 'api', 'cli')

# the summary line of qa/bin/functional listing the failed tests: `failed    43 [0, 1, ...]`
FAILED_LINE = re.compile(r'failed\s+\d+\s+\[([^\]]+)\]')
ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')


def first_failed(output: str) -> str:
    """The ID of the first test the summary lists as failed, or '' when none is listed."""
    found = FAILED_LINE.search(ANSI.sub('', output))
    return found.group(1).split(',')[0].strip() if found else ''


def run_suite(suite: str, environment: dict[str, str]) -> int:
    """Run a suite quietly; when it fails, run its first failed test alone to show why.

    --quiet prints the summary and nothing about a failure, which leaves a CI log with no
    cause. A test run alone prints the daemon's and the test peer's output in full.
    """
    functional = [sys.executable, str(ROOT / 'qa' / 'bin' / 'functional'), suite]
    result = subprocess.run(functional + ['--quiet'], env=environment, capture_output=True, text=True)
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    sys.stdout.flush()
    if not result.returncode:
        return 0
    failed = first_failed(result.stdout)
    if failed:
        print(f'test_wheel: the {suite} suite failed, running test {failed} alone to show why', flush=True)
        subprocess.run(functional + [failed], env=environment)
    return result.returncode


# every module of the installed package, loaded once in a process of its own
WARM_UP = """
import importlib, pkgutil, exabgp
failed = []
for module in pkgutil.walk_packages(exabgp.__path__, 'exabgp.'):
    try:
        importlib.import_module(module.name)
    except Exception as exc:
        failed.append(f'{module.name}: {exc}')
print(*failed, sep='\\n')
raise SystemExit(1 if failed else 0)
"""
WARM_UP_TIMEOUT_SECONDS = 600


def warm_up(environment: dict[str, str]) -> None:
    """Load every module of the installed package once, before the suites start daemons.

    The first load of a freshly installed compiled wheel is slow on macOS, which checks each
    new library as it is opened: 8.4 seconds measured locally against 0.7 for the next load.
    A suite starts its daemons together, each with 20 seconds to answer, and on the macOS
    runner all 47 encoding daemons, still opening their libraries, ran out of time and
    printed nothing. A user pays this once, on the first start.
    """
    started = time.monotonic()
    command = [sys.executable, '-c', WARM_UP]
    result = subprocess.run(
        command, env=environment, cwd='/', capture_output=True, text=True, timeout=WARM_UP_TIMEOUT_SECONDS
    )
    if result.returncode:
        sys.exit(f'test_wheel: a module of the installed package does not load:\n{result.stdout}{result.stderr}')
    print(f'test_wheel: every module loaded once in {time.monotonic() - started:.1f}s', flush=True)


def installed() -> Path:
    """The directory holding the installed exabgp package, never the checkout's src."""
    source = str(ROOT / 'src')
    sys.path[:] = [entry for entry in sys.path if os.path.abspath(entry or '.') != source]
    import exabgp

    package = Path(exabgp.__file__).parent
    if package.parent == ROOT / 'src':
        sys.exit('test_wheel: exabgp comes from the checkout, not from an installed wheel')
    return package.parent


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--pure', action='store_true', help='the installed package is not compiled')
    arguments = parser.parse_args()

    tree = installed()
    from exabgp.application.version import build

    expected = 'python' if arguments.pure else 'mypyc'
    if build() != expected:
        print(f'test_wheel: the installed exabgp runs as {build()}, expected {expected}')
        return 1
    print(f'test_wheel: exabgp from {tree}, build {build()}')

    environment = dict(os.environ, EXABGP_TREE=str(tree), INTERPRETER=sys.executable)
    environment.pop('PYTHONPATH', None)
    if os.geteuid() == 0:
        # cibuildwheel tests on Linux as root, from a venv in a 0700 directory: the daemon
        # would drop to nobody, who can not read the package, and rightly refuse to start
        environment['exabgp_daemon_user'] = 'root'
    warm_up(environment)
    for suite in SUITES:
        returncode = run_suite(suite, environment)
        if returncode:
            print(f'test_wheel: the {suite} suite failed')
            return returncode
    return 0


if __name__ == '__main__':
    sys.exit(main())
