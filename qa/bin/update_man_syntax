#!/usr/bin/env python3
"""update_man_syntax

Print the configuration syntax of doc/man/exabgp.conf.5 from the grammar which reads it.

The block between the two markers is replaced, the prose around it is written by hand and
left alone. tests/unit/test_man_configuration_syntax.py fails when the page is out of date.

Usage:
    qa/bin/update_man_syntax           # rewrite the block
    qa/bin/update_man_syntax --check   # exit 1 when the block is out of date

Copyright (c) 2009-2026 Exa Networks. All rights reserved.
License: 3-clause BSD. (See the COPYRIGHT file)
"""

from __future__ import annotations

import os
import sys

ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
sys.path.insert(0, os.path.join(ROOT, 'src'))
os.environ.setdefault('exabgp_log_enable', 'false')

from exabgp.configuration.grammar.describe import manual, syntax  # noqa: E402
from exabgp.configuration.grammar.tree.root import ROOT as GRAMMAR  # noqa: E402

PAGE = os.path.join(ROOT, 'doc', 'man', 'exabgp.conf.5')
START = '.\\" syntax: generated by qa/bin/update_man_syntax, do not edit'
END = '.\\" syntax: end'
WIDTH = 78


def main() -> int:
    with open(PAGE, encoding='utf-8') as page:
        lines = page.read().splitlines()
    if START not in lines or END not in lines:
        sys.stderr.write(f'{PAGE}: the markers around the syntax block are missing\n')
        return 1
    start, end = lines.index(START), lines.index(END)
    updated = lines[: start + 1] + manual(syntax(GRAMMAR), WIDTH) + lines[end:]
    if updated == lines:
        return 0
    if '--check' in sys.argv[1:]:
        sys.stderr.write(f'{PAGE}: the syntax block is out of date, run qa/bin/update_man_syntax\n')
        return 1
    with open(PAGE, 'w', encoding='utf-8') as page:
        page.write('\n'.join(updated) + '\n')
    return 0


if __name__ == '__main__':
    sys.exit(main())
