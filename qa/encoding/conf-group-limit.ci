option:file:conf-group-limit.conf
# The MP_REACH_NLRI captures in this file were re-recorded when the encoder stopped emitting
# that attribute last.  RFC 7606 5.1: "The MP_REACH_NLRI or MP_UNREACH_NLRI attribute (if
# present) SHALL be encoded as the very first path attribute in an UPDATE message."  Only the
# position of the attribute moved: the same attributes with the same values, and the same NLRI,
# are on the wire, which is why no json: expectation changed with them.
# EOR
1:cmd:announce eor ipv4 unicast
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:0017:02:00000000
1:cmd:announce eor ipv6 unicast
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:001E:02:00000007900F0003000201

# Two IPv4
1:cmd:announce attributes next-hop 10.0.0.1 origin igp local-preference 100 nlri 193.0.2.1/32 193.0.2.2/32
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:0036:02:00000015400101004002004003040A0000014005040000006420C100020120C1000202
1:json:{"exabgp":"6.0.0","type":"update","neighbor":{"address":{"local":"127.0.0.1","peer":"127.0.0.1"},"asn":{"local":1,"peer":1},"router-id":"1.2.3.4","direction":"in","message":{"update":{"attribute":{"origin":"igp","local-preference":100},"announce":{"ipv4 unicast":{"10.0.0.1":[{"nlri":"193.0.2.1/32"},{"nlri":"193.0.2.2/32"}]}}}}}}

# Two IPv6
1:cmd:announce ipv6 unicast 2a02:b80:0:1::1/128 next-hop 2a02:b80:1::1 origin igp local-preference 100
