option:file:conf-flow-addpath.conf
# issue #1140: RFC 7911 ADD-PATH for FlowSpec.  The first two routes share one match and are
# two paths, told apart by the four octet path identifier in front of each NLRI.
1:cmd:announce ipv4 flow destination-ipv4 10.0.0.0/24 path-information 0.0.0.1 rate-limit 0
