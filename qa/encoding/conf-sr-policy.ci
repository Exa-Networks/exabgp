1:json:{"exabgp":"6.0.0","type":"update","neighbor":{"address":{"local":"127.0.0.1","peer":"127.0.0.1"},"asn":{"local":65533,"peer":65533},"router-id":"1.2.3.4","direction":"in","message":{"update":{"attribute":{"origin":"igp","local-preference":100,"tunnel-encap":{"sr-policy":{"preference":300,"segment-lists":[{"weight":1,"segments":[{"type":"A","label":16001,"tc":0,"s":false,"ttl":0}]},{"weight":2,"segments":[{"type":"A","label":16002,"tc":0,"s":false,"ttl":0}]}]}}},"announce":{"ipv4 sr-policy":{"192.0.2.1":[{"distinguisher":0,"color":300,"endpoint":"10.0.0.3"}]}}}}}}
# IPv6 SR Policy: SRv6 segment type-B
1:cmd:announce ipv6 sr-policy distinguisher 0 color 100 endpoint 2001:db8::1 next-hop 2001:db8::2 preference 100 segment-list weight 1 segment type-b srv6 2001:db8:1::1
