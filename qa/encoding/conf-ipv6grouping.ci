option:file:conf-ipv6grouping.conf
# The MP_REACH_NLRI captures in this file were re-recorded when the encoder stopped emitting
# that attribute last.  RFC 7606 5.1: "The MP_REACH_NLRI or MP_UNREACH_NLRI attribute (if
# present) SHALL be encoded as the very first path attribute in an UPDATE message."  Only the
# position of the attribute moved: the same attributes with the same values, and the same NLRI,
# are on the wire, which is why no json: expectation changed with them.
1:cmd:announce ipv6 unicast 2a02:b80:0:1::1/128 next-hop 2a02:b80:0:2::1 origin igp local-preference 200 community [30740:0 30740:30740]
1:raw:FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF:0059:02:00000042800E26000201102A020B8000000002000000000000000100802A020B8000000001000000000000000140010100400200400504000000C8C008087814000078147814
1:json:{"exabgp":"6.0.0","type":"update","neighbor":{"address":{"local":"127.0.0.1","peer":"127.0.0.1"},"asn":{"local":1,"peer":1},"router-id":"1.2.3.4","direction":"in","message":{"update":{"attribute":{"origin":"igp","local-preference":200,"community":[[30740,0],[30740,30740]]},"announce":{"ipv6 unicast":{"2a02:b80:0:2::1":[{"nlri":"2a02:b80:0:1::1/128"}]}}}}}}
1:cmd:announce ipv6 unicast 2a02:b80:0:1::2/128 next-hop 2a02:b80:0:2::1 origin igp local-preference 200 community [30740:0 30740:30740]
