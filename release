import argparse
import fileinput
import glob
import importlib.machinery
import importlib.util
import os
import re
import shutil
import subprocess
import sys
import tomllib
import zipapp
import zipfile
from pathlib import Path as FilePath
from types import ModuleType

CHANGELOG = 'doc/CHANGELOG.rst'


class Path:
    root = os.path.join(os.getcwd(), os.path.dirname(sys.argv[0]))
    changelog = os.path.join(root, CHANGELOG)
    pyproject = os.path.join(root, 'pyproject.toml')
    lib_exa = os.path.join(root, 'src/exabgp')
    debian = os.path.join(root, 'debian/changelog')
    egg = os.path.join(root, 'src/exabgp.egg-info')
    build_exabgp = os.path.join(root, 'build/src/exabgp')
    build_root = os.path.join(root, 'build')

    @classmethod
    def remove_egg(cls, *args):
        from shutil import rmtree

        print('removing left-over egg')
        if os.path.exists(cls.egg):
            rmtree(cls.egg)
        if os.path.exists(cls.build_exabgp):
            rmtree(cls.build_root)
        return 0


class Version:
    """Version management - reads/writes pyproject.toml as single source of truth."""

    @staticmethod
    def current() -> str:
        """Read current version from pyproject.toml."""
        with open(Path.pyproject, 'rb') as f:
            return tomllib.load(f)['project']['version']

    @staticmethod
    def changelog() -> str:
        """Read version from CHANGELOG.rst (for reference/validation)."""
        with open(Path.changelog) as f:
            f.readline()  # Skip first line
            for line in f:
                if line.lower().startswith('version '):
                    return line.split()[1].rstrip().rstrip(':').strip()
        return ''

    @staticmethod
    def set(new_version: str) -> bool:
        """Update version in pyproject.toml."""
        with open(Path.pyproject, 'r') as f:
            content = f.read()
        content = re.sub(r"^version = '[^']+'", f"version = '{new_version}'", content, flags=re.MULTILINE)
        with open(Path.pyproject, 'w') as f:
            f.write(content)
        return Version.current() == new_version

    @staticmethod
    def valid(tag: str) -> bool:
        """Check if tag is a valid semantic version."""
        parts = tag.split('.')
        return len(parts) == 3 and all(p.isdigit() for p in parts)

    @staticmethod
    def latest(tags: list) -> str:
        """Get the latest version from a list of tags."""
        valid = [[int(p) for p in tag.split('.')] for tag in tags if Version.valid(tag)]
        return '.'.join(str(p) for p in sorted(valid)[-1])

    @staticmethod
    def candidates(tag: str) -> list:
        """Get valid next version candidates for a given tag."""
        parts = [int(p) for p in tag.split('.')]
        return [
            f'{parts[0]}.{parts[1]}.{parts[2] + 1}',
            f'{parts[0]}.{parts[1] + 1}.0',
            f'{parts[0] + 1}.0.0',
        ]


class Debian:
    template = """\
exabgp (%s-0) unstable; urgency=low

  * Latest ExaBGP release.

 -- Vincent Bernat <bernat@debian.org>  %s

"""

    @staticmethod
    def set(version):
        from email.utils import formatdate

        with open(Path.debian, 'w') as w:
            w.write(Debian.template % (version, formatdate()))
        print('updated debian/changelog')


class Command:
    dryrun = 'dry-run' if os.environ.get('DRY', os.environ.get('DRYRUN', os.environ.get('DRY_RUN', False))) else ''

    @staticmethod
    def run(cmd):
        print('>', cmd)
        return Git.dryrun or os.system(cmd)


class Git(Command):
    @staticmethod
    def commit(comment):
        return Git.run('git commit -a -m "%s"' % comment)

    @staticmethod
    def push(tag=False, repo=''):
        command = 'git push'
        if tag:
            command += ' --tags'
        if repo:
            command += ' %s' % repo
        return Git.run(command)

    @staticmethod
    def head_commit():
        return os.popen('git rev-parse --short HEAD').read().strip()

    @staticmethod
    def tags():
        return os.popen('git tag').read().split('-')[0].strip().split('\n')

    @staticmethod
    def tag(release):
        return Git.run('git tag -s -a %s -m "release %s"' % (release, release))

    @staticmethod
    def pending():
        # Check if only expected files are modified for a release
        commit = None
        for line in os.popen('git status').read().split('\n'):
            if 'modified:' in line:
                # Allow pyproject.toml (version), debian/changelog, and README changes
                if 'pyproject.toml' in line or 'debian/changelog' in line or 'README' in line:
                    if commit is not False:
                        commit = True
                else:
                    return False
            elif 'renamed:' in line:
                return False
        return commit


#
# Check that that there is no version inconsistancy before any pypi action
#


def release_github(args):
    print()
    print('updating Github')

    current = Version.current()
    print('current version is %s (from pyproject.toml)' % current)

    release = Version.changelog()
    print('release version is %s (from %s)' % (release, CHANGELOG))

    if not Version.valid(release):
        print('invalid new version in %s' % CHANGELOG)
        return 1

    tags = Git.tags()
    if release in tags:
        print(f'version {release} was already released/used')
        return 1

    candidates = Version.candidates(Version.latest(tags))
    if release not in candidates:
        print('valid versions are:', ', '.join(candidates))
        print('this release is not one of the candidates')

    print('updating pyproject.toml')
    Version.set(release)
    print('updating debian/changelog')
    Debian.set(release)

    print('updating ', end='')
    for readme in ('README.md', 'doc/README.rst'):
        print(readme + ' ', end='')
        with fileinput.FileInput(readme, inplace=True) as replacer:
            for line in replacer:
                print(line.replace(current, release), end='')
    print()

    print('checking if we need to commit a version.py change')
    status = Git.pending()
    if status is None:
        print('all is already set for release')
    elif status is False:
        print('more than one file is modified and need updating, aborting')
        return 1
    else:
        if Git.commit('updating version to %s' % release):
            print('could not commit version change (%s)' % release)
            return 1
        print('version was updated')

    print('tagging the new version')
    if Git.tag(release):
        print('could not tag version (%s)' % release)
        return 1

    print('pushing the new tag')
    if Git.push(tag=True, repo='origin'):
        print('could not push release tag to origin')
        return 1

    if Git.push(tag=False, repo='origin'):
        print('could not push release version to origin')
        return 1

    if Git.push(tag=True, repo='upstream'):
        print('could not push release tag to upstream')
        return 1

    if Git.push(tag=False, repo='upstream'):
        print('could not push release version to upstream')
        return 1
    return 0


def release_pypi(args):
    test = args.test

    print()
    print('updating PyPI')

    Path.remove_egg()

    if Command.run('python3 setup.py sdist bdist_wheel'):
        print('could not generate egg')
        return 1

    # keyring used to save credential
    # https://pypi.org/project/twine/

    release = Version.latest(Git.tags())

    server = ''
    if test:
        server = '--repository-url https://test.pypi.org/legacy/'

    if Command.run('twine upload %s dist/exabgp-%s.tar.gz' % (server, release)):
        print('could not upload with twine')
        return 1

    print('all done.')
    return 0


def remove_cache():
    for name in glob.glob('./src/*/__pycache__'):
        shutil.rmtree(name)
    for name in glob.glob('./src/*/*/__pycache__'):
        shutil.rmtree(name)

    for name in glob.glob('./src/*/*.pyc'):
        os.remove(name)
    for name in glob.glob('./src/*/*/*.pyc'):
        os.remove(name)


# the zipapp: the pure Python wheel, as one file any Python 3.12 or later runs
ZIPAPP_WORK = os.path.join(Path.root, 'build', 'zipapp')
ZIPAPP_DIST = os.path.join(Path.root, 'dist')
ZIPAPP_INTERPRETER = '/usr/bin/env python3'
ZIPAPP_DEBUG_INTERPRETER = '/usr/bin/env EXABGP_DEBUG_PDB=1 EXABGP_DEBUG_CONFIGURATION=1 EXABGP_DEBUG_ROUTE=1 python3'
# what runs first: python3 is whatever the PATH finds, often older than 3.12, which would
# otherwise stop on the SyntaxError of the first module using newer syntax. Written for any
# Python 3, so no f-string. It exits as the console script pip writes does
ZIPAPP_MAIN = """import sys

if sys.version_info < (3, 12):
    sys.exit('exabgp requires Python 3.12 or later, %s is Python %d.%d' % ((sys.executable,) + sys.version_info[:2]))

from exabgp.application.main import main

sys.exit(main())
"""
# what of the wheel the zipapp holds: not the example configurations of <name>.data
ZIPAPP_CONTENT = re.compile(r'^exabgp(-[^/]+\.dist-info)?/')
# the wheel holds a few hundred files: more is not the wheel this script built
ZIPAPP_MAX_MEMBERS = 5000


def load_build_binary() -> ModuleType:
    """qa/bin/build_binary, whose checks run any executable and know nothing of PyInstaller."""
    path = os.path.join(Path.root, 'qa', 'bin', 'build_binary')
    loader = importlib.machinery.SourceFileLoader('build_binary', path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None, f'{path} can not be loaded'
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def zipapp_wheel(build: ModuleType, version: str) -> FilePath:
    """The pure Python wheel, built from a copy of the checkout, at `version` if given."""
    source = FilePath(ZIPAPP_WORK) / 'source'
    wheels = FilePath(ZIPAPP_WORK) / 'wheel'
    build.copy_sources(source)
    if version:
        pyproject = source / 'pyproject.toml'
        text, count = re.subn(
            r"^version = '[^']+'$", f"version = '{version}'", pyproject.read_text(), flags=re.MULTILINE
        )
        if count != 1:
            sys.exit(f'expected one version line in {pyproject}, found {count}')
        pyproject.write_text(text)
    if wheels.exists():
        shutil.rmtree(wheels)
    command = [build.uv(), 'build', '--wheel', '--no-build-isolation', '--python', sys.executable]
    command += ['--out-dir', str(wheels), str(source)]
    print('>', ' '.join(command), flush=True)
    subprocess.run(command, check=True, cwd=Path.root, env=build.environment())
    found = sorted(wheels.glob('exabgp-*-py3-none-any.whl'))
    if len(found) != 1:
        sys.exit(f'expected one pure Python wheel in {wheels}, found {len(found)}')
    return found[0]


def zipapp_tree(wheel: FilePath) -> tuple[FilePath, str]:
    """The package and its metadata out of the wheel, so `version` reports the zipapp's own."""
    target = FilePath(ZIPAPP_WORK) / 'app'
    if target.exists():
        shutil.rmtree(target)
    with zipfile.ZipFile(wheel) as archive:
        names = archive.namelist()
        if len(names) > ZIPAPP_MAX_MEMBERS:
            sys.exit(f'{wheel} holds {len(names)} files, more than {ZIPAPP_MAX_MEMBERS}')
        archive.extractall(target, [name for name in names if ZIPAPP_CONTENT.match(name)])
    metadata = sorted(target.glob('exabgp-*.dist-info'))
    if len(metadata) != 1 or not (target / 'exabgp' / '__main__.py').is_file():
        sys.exit(f'{wheel} does not hold the exabgp package and one dist-info')
    (target / '__main__.py').write_text(ZIPAPP_MAIN)
    return target, metadata[0].name.removeprefix('exabgp-').removesuffix('.dist-info')


def check_binary(build: ModuleType, pyz: FilePath, functional: bool) -> None:
    """version, encode, decode, configuration validate and server, then the functional suites."""
    report = build.execute(pyz, 'version')
    print(report, end='')
    if 'Build  : python' not in report or f'From   : {pyz}' not in report:
        sys.exit(f'{pyz} does not run the package it holds')
    update = build.execute(pyz, 'encode', build.ROUTE).strip()
    decoded = build.execute(pyz, 'decode', stdin=update + '\n')
    if '10.0.0.0/24' not in decoded or '65001' not in decoded:
        sys.exit(f'{update} decodes to {decoded}')
    build.execute(pyz, 'configuration', 'validate', '-nrv', str(build.CONFIGURATION))
    build.check_server(pyz)
    print(f'{pyz} runs version, encode, decode, validate and server')
    if functional:
        build.check_functional(pyz)


def generate_binary(args):
    """The zipapp, dist/exabgp-<version>.pyz unless a target is named, checked once built."""
    build = load_build_binary()
    if args.test:
        check_binary(build, FilePath(args.test).resolve(), args.functional)
        return 0
    os.makedirs(ZIPAPP_WORK, exist_ok=True)
    tree, version = zipapp_tree(zipapp_wheel(build, args.version))
    os.makedirs(ZIPAPP_DIST, exist_ok=True)
    target = FilePath(args.target or os.path.join(ZIPAPP_DIST, f'exabgp-{version}.pyz')).resolve()
    interpreter = ZIPAPP_DEBUG_INTERPRETER if args.debug else ZIPAPP_INTERPRETER
    zipapp.create_archive(tree, target, interpreter=interpreter, compressed=not args.debug)
    print(f'built {target}')
    check_binary(build, target, args.functional)
    return 0


def show_version(args):
    if args.version == 'current':
        print(Version.current())
    if args.version == 'release':
        print(Version.changelog())


def main():
    # To late for it .. but here as a reminder that it can be done
    os.environ['PYTHONDONTWRITEBYTECODE'] = ''

    if os.environ.get('SCRUTINIZER', '') == 'true':
        sys.exit(0)

    if len(sys.argv) > 1 and sys.argv[1] == 'debian':
        release = Version.changelog()
        Debian.set(release)
        sys.exit(0)

    parser = argparse.ArgumentParser(description='exabgp release tool')
    root = parser.add_subparsers()

    binary = root.add_parser('binary', help='build the zipapp, one file any Python 3.12 or later runs')
    binary.add_argument('target', nargs='?', default='', help='the file to create (dist/exabgp-<version>.pyz)')
    binary.add_argument('-d', '--debug', help='run python with pdb', action='store_true')
    binary.add_argument('--version', default='', help='the version to build, rather than that of pyproject.toml')
    binary.add_argument('--test', metavar='PYZ', help='do not build, check this zipapp')
    binary.add_argument('--functional', action='store_true', help='also run the functional suites against it')
    binary.set_defaults(func=generate_binary)

    pypi = root.add_parser('pypi', help='create egg/wheel')
    pypi.add_argument('-t', '--test', help='only test', action='store_true')
    pypi.set_defaults(func=release_pypi)

    github = root.add_parser('github', help='tag a new version on github, and update pypi')
    github.set_defaults(func=release_github)

    cleanup = root.add_parser('cleanup', help='delete left-over file from release')
    cleanup.set_defaults(func=Path.remove_egg)

    show = root.add_parser('show', help='show exabgp version')
    show.add_argument('version', help='which version', choices=['current', 'release'])
    show.set_defaults(func=show_version)

    args = parser.parse_args()
    if 'func' not in dir(args):
        sys.exit(1)
    args.func(args)
    sys.exit(0)


if __name__ == '__main__':
    main()
