#!/usr/bin/env python3
"""Announce and withdraw, so RFC 7606 5.1 has something to split.

Steps three and four go out in a single write, announcement first, so the daemon has both
in hand before it flushes its adj-rib-out.  What must come back is the other way round: a
prefix being replaced is withdrawn before the route replacing it is advertised, or the peer
holds, for as long as the two packets are apart, a route it was told to drop.  The .ci file
puts each of them in a sequence of its own, which is what makes the test assert the order
rather than only the contents.

Each step waits for the UPDATEs of the one before to have been sent, never for a pause: a
slow machine stretches a pause until two steps share a flush, and the test then asserts an
order nobody asked for.
"""

from exabgp_api import counters, send, trace, wait_for_ack, wait_for_shutdown

BARRIER_TIMEOUT = 20.0


def barrier(what: str, expected_count: int = 1, **events) -> None:
    if wait_for_ack(expected_count=expected_count, timeout=BARRIER_TIMEOUT, **events):
        trace(f'{what} ok')
        return
    raise SystemExit(f'{what} never happened, saw {counters()}')


def main() -> None:
    # (what is written in one go, what must have been sent before the next step)
    steps = [
        # The two families, announced one at a time, so each opening UPDATE is on its own.
        (
            'announce route 10.0.0.0/24 next-hop 192.0.2.1 med 100',
            {'announce': (('10.0.0.0/24', 1),)},
        ),
        (
            'announce route 2001:db8:1::/64 next-hop 2001:db8::1 med 100',
            {'announce': (('2001:db8:1::/64', 1),)},
        ),
        # One write, announcement asked for first: the legacy IPv4 fields.
        (
            'announce route 10.0.2.0/24 next-hop 192.0.2.1 med 100\n'
            'withdraw route 10.0.0.0/24 next-hop 192.0.2.1 med 100',
            {'announce': (('10.0.2.0/24', 1),), 'withdraw': (('10.0.0.0/24', 1),)},
        ),
        # One write, announcement asked for first: an MP family.
        (
            'announce route 2001:db8:2::/64 next-hop 2001:db8::1 med 100\n'
            'withdraw route 2001:db8:1::/64 next-hop 2001:db8::1 med 100',
            {'announce': (('2001:db8:2::/64', 1),), 'withdraw': (('2001:db8:1::/64', 1),)},
        ),
    ]

    barrier('the session coming up', expected_count=0, state=(('up', 1),))

    for command, sent in steps:
        send(command)
        barrier(command.replace('\n', ' then '), expected_count=command.count('\n') + 1, **sent)

    wait_for_shutdown()


if __name__ == '__main__':
    main()
