#!/usr/bin/env python3

from exabgp_api import counters, send, trace, wait_for_ack

# the process exits once its route is on the wire, without waiting for a shutdown:
# ExaBGP must then withdraw what it announced: without on-exit, the routes of an API 6
# helper are withdrawn (an API 4 one keeps them, as 4.x and 5.x did)
# exiting before the session is up would cancel the announce inside the RIB, and
# the peer would see neither message
BARRIER_TIMEOUT = 20.0


def barrier(what: str, expected_count: int = 1, **events) -> None:
    if wait_for_ack(expected_count=expected_count, timeout=BARRIER_TIMEOUT, **events):
        trace(f'{what} ok')
        return
    raise SystemExit(f'{what} never happened, saw {counters()}')


def main() -> None:
    barrier('the session coming up', expected_count=0, state=(('up', 1),))
    send('peer * announce route 1.1.1.1/32 next-hop 11.11.11.11')
    barrier('1.1.1.1/32 on the wire', announce=(('1.1.1.1/32', 1),))
    trace('exiting')


if __name__ == '__main__':
    main()
